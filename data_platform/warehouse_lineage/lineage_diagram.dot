  semantic_anchor [label="", shape=point, width=0, style=invis];
  raw_anchor -> stg_anchor [style=invis, weight=200, minlen=2];
  stg_anchor -> int_anchor_2 [style=invis, weight=200, minlen=2];
  int_anchor_2 -> int_anchor_1 [style=invis, weight=200, minlen=2];
  int_anchor_1 -> int_anchor_0 [style=invis, weight=200, minlen=2];
  int_anchor_0 -> marts_anchor [style=invis, weight=200, minlen=2];
  marts_anchor -> semantic_anchor [style=invis, weight=200, minlen=2];

