digraph lineage {
  rankdir=RL;
  graph [pad="0.9", nodesep="1.15", ranksep="2.9", splines=ortho, concentrate=false, fontname="Segoe UI", center=true, newrank=true, labelloc="t", labeljust="c", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="16" CELLPADDING="0">
  <TR>
    <TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="26"><B>Cycle Superstore Data Warehouse Lineage</B></FONT></TD>
  </TR>
  <TR>
    <TD ALIGN="CENTER" VALIGN="TOP">
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#94a3b8">
        <TR><TD BGCOLOR="#e2e8f0" ALIGN="CENTER"><B>Node Types</B></TD></TR>
        <TR><TD BGCOLOR="#ffffff" ALIGN="LEFT">Square box = table<BR ALIGN="LEFT"/>Rounded box = view<BR ALIGN="LEFT"/>Edge color = originating object</TD></TR>
      </TABLE>
    </TD>
    <TD ALIGN="CENTER" VALIGN="TOP">
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8" COLOR="#94a3b8">
        <TR><TD BGCOLOR="#e2e8f0" ALIGN="CENTER"><B>Bronze Sources</B></TD></TR>
        <TR><TD BGCOLOR="#ffffff" ALIGN="LEFT">
          <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">
          <TR><TD WIDTH="18" HEIGHT="18" BGCOLOR="#ffedd5"></TD><TD ALIGN="LEFT">Microsoft 365 [Email]</TD></TR>
          <TR><TD WIDTH="18" HEIGHT="18" BGCOLOR="#e2e8f0"></TD><TD ALIGN="LEFT">CCData [Main ERP]</TD></TR>
          <TR><TD WIDTH="18" HEIGHT="18" BGCOLOR="#ede9fe"></TD><TD ALIGN="LEFT">CSS2 [Website data]</TD></TR>
          <TR><TD WIDTH="18" HEIGHT="18" BGCOLOR="#dcfce7"></TD><TD ALIGN="LEFT">Google Ads + Merchant Center [Advertising and product data]</TD></TR>
          <TR><TD WIDTH="18" HEIGHT="18" BGCOLOR="#fce7f3"></TD><TD ALIGN="LEFT">Bizimply [Payroll timecards]</TD></TR>
          <TR><TD WIDTH="18" HEIGHT="18" BGCOLOR="#dbeafe"></TD><TD ALIGN="LEFT">Xero [Accounting data]</TD></TR>
          </TABLE>
        </TD></TR>
      </TABLE>
    </TD>
  </TR>
  <TR>
    <TD COLSPAN="2" ALIGN="LEFT">
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3">
        <TR><TD ALIGN="LEFT"><B>How to read this lineage</B></TD></TR>
        <TR><TD ALIGN="LEFT">This map shows how source data enters the Microsoft Fabric model at Bronze, is shaped through Silver and Intermediate, consolidated in Gold, and exposed through the Semantic layer.</TD></TR>
        <TR><TD ALIGN="LEFT">Each node is a warehouse table or view. Arrows point from an object to its upstream dependencies, so read the diagram right to left.</TD></TR>
        <TR><TD ALIGN="LEFT">Example layer path: read right to left</TD></TR>
        <TR>
          <TD ALIGN="LEFT">
            <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4" CELLPADDING="5">
              <TR>
                <TD BGCOLOR="#eff6ff">Semantic</TD><TD><FONT POINT-SIZE="15">&#8592;</FONT></TD>
                <TD BGCOLOR="#fef2f2">Gold</TD><TD><FONT POINT-SIZE="15">&#8592;</FONT></TD>
                <TD BGCOLOR="#fffbeb">Intermediate</TD><TD><FONT POINT-SIZE="15">&#8592;</FONT></TD>
                <TD BGCOLOR="#f0fdf4">Silver</TD><TD><FONT POINT-SIZE="15">&#8592;</FONT></TD>
                <TD BGCOLOR="#e2e8f0">Bronze</TD>
              </TR>
            </TABLE>
          </TD>
        </TR>
      </TABLE>
    </TD>
  </TR>
</TABLE>>];
  node [fontsize=14, fontname="Segoe UI", color="#334155", penwidth=1.35, margin="0.16,0.11"];
  edge [color="#64748b", arrowsize=0.8, penwidth=1.2];

  raw_layer [label="BRONZE LAYER", shape=plaintext, fontsize=18, fontcolor="#1d4ed8"];
  stg_layer [label="SILVER LAYER", shape=plaintext, fontsize=18, fontcolor="#166534"];
  int_layer [label="INTERMEDIATE", shape=plaintext, fontsize=18, fontcolor="#92400e"];
  marts_layer [label="GOLD LAYER", shape=plaintext, fontsize=18, fontcolor="#991b1b"];
  semantic_layer [label="SEMANTIC LAYER", shape=plaintext, fontsize=18, fontcolor="#0369a1"];
  raw_anchor [label="", shape=point, width=0, style=invis];
  stg_anchor [label="", shape=point, width=0, style=invis];
  int_anchor_2 [label="", shape=point, width=0, style=invis];
  int_anchor_1 [label="", shape=point, width=0, style=invis];
