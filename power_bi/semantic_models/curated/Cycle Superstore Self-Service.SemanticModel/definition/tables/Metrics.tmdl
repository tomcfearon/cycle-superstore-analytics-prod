	measure 'Stock On Hand' =
			
			VAR AbsoluteLatestDate =
			    CALCULATE (
			        MAX ( 'Inventory'[Query Date] ),
			        REMOVEFILTERS ( 'Inventory' )
			    )
			VAR TotalInventory =
			    CALCULATE (
			        [Total Inventory],
			        'Inventory'[Query Date] = AbsoluteLatestDate
			    )
			RETURN
			    IF ( TotalInventory = 0, BLANK (), TotalInventory )
		displayFolder: Inventory\_Balances
		lineageTag: 26823e7e-88f1-4b9c-9d00-189f7e5be701

	measure 'T1 Stock On Hand' =
			
			VAR AbsoluteLatestDate =
			    CALCULATE (
			        MAX ( 'Inventory'[Query Date] ),
			        REMOVEFILTERS ( 'Inventory' )
			    )
			VAR TotalInventory =
			    CALCULATE ( [T1 Inventory], 'Inventory'[Query Date] = AbsoluteLatestDate )
			RETURN
			    IF ( TotalInventory = 0, BLANK (), TotalInventory )
		displayFolder: Inventory\_Balances
		lineageTag: 38f0f5b0-7619-439d-9b5c-07dd1d287ef0

	measure 'Cara Stock On Hand' =
			
			VAR AbsoluteLatestDate =
			    CALCULATE (
			        MAX ( 'Inventory'[Query Date] ),
			        REMOVEFILTERS ( 'Inventory' )
			    )
			VAR TotalInventory =
			    CALCULATE (
			        [Cara Inventory],
			        'Inventory'[Query Date] = AbsoluteLatestDate
			    )
			RETURN
			    IF ( TotalInventory = 0, BLANK (), TotalInventory )
		displayFolder: Inventory\_Balances
		lineageTag: 6ac35f87-657f-4cdd-9195-e9cc29b813bb

	measure 'Stock Units' =
			
			VAR LastAvailableDate =
