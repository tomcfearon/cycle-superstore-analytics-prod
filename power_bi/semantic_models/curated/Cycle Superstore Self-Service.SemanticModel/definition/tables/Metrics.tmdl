	measure 'Stock Value' =
			
			VAR LastAvailableDate =
			    LASTDATE ( 'Date'[Date] )
			RETURN
			    CALCULATE (
			        SUMX ( 'Product', [Total Inventory] * 'Product'[Cost Price] ),
			        'Inventory'[Query Date] = LastAvailableDate
			    )
		displayFolder: Inventory\Valuations
		lineageTag: 3b653a31-ee63-4bb6-ba75-c147fdda54e1

