	column 'Store Hours Sort'
		isHidden
		formatString: 0
		lineageTag: 7e3b78d6-e453-4fb0-aab8-861801ff7c32
		summarizeBy: none
		isNameInferred
		sourceColumn: [Store Hours Sort]

		annotation SummarizationSetBy = Automatic

	partition '56 - Time' = calculated
		mode: import
		source = ```
				
				    VAR openS  = 9 * 3600
				    VAR closeS = 20 * 3600 + 15 * 60    -- 20:15
				    
				    -- Define the irregular block split logic here so we can reuse values if needed
				    -- However, inside ADDCOLUMNS we often have to repeat logic or use nested steps.
				    -- For simplicity, I have corrected the Sort Logic below.
				
				    VAR RESULT =
				    ADDCOLUMNS (
				        GENERATESERIES ( 0, 86399, 1 ),
				        
				        "Second Of Day", [Value],
				        "Hour Number", INT ( [Value] / 3600 ),
				        "Minute Of Hour", INT ( MOD ( [Value], 3600 ) / 60 ),
				        "Second Of Minute", MOD ( [Value], 60 ),
				        
				        -- CHANGED: Return a TIME object, not Text. Format this as HH:mm:ss in the UI.
				        "Time", TIME (
				                INT ( [Value] / 3600 ),
				                INT ( MOD ( [Value], 3600 ) / 60 ),
				                MOD ( [Value], 60 )
				            ),
				            
				        "Hour", FORMAT ( INT ( [Value] / 3600 ), "00" ) & ":00",
				
				        "Store Hours Category",
				        VAR v = [Value]
				        VAR firstStart = openS              -- 09:00
				        VAR firstEnd   = 10 * 3600 + 15 * 60 -- 10:15
				        VAR start2     = firstEnd           -- 10:15
				        VAR idx        = INT ( ( v - start2 ) / 3600 )
				        
				        VAR blockStart =
				            IF ( v < firstEnd, firstStart, start2 + idx * 3600 )
				        
				        VAR blockEnd =
				            IF (
				                v < firstEnd,
				                firstEnd,
				                MIN ( start2 + ( idx + 1 ) * 3600, closeS )
				            )
				        
				        VAR label =
				            FORMAT ( TIME ( INT ( blockStart / 3600 ), INT ( MOD ( blockStart, 3600 ) / 60 ), 0 ), "HH:mm" )
				                & "–" &
				            FORMAT ( TIME ( INT ( blockEnd / 3600 ),   INT ( MOD ( blockEnd, 3600 ) / 60 ),   0 ), "HH:mm" )
				        
				        RETURN
				            IF ( v >= openS && v < closeS, label, "Closed Hours" ),
				
				        -- FIXED SORT COLUMN
				        "Store Hours Sort",
				        VAR v = [Value]
				        VAR firstEnd   = 10 * 3600 + 15 * 60
				        VAR start2     = firstEnd
				        VAR idx        = INT ( ( v - start2 ) / 3600 )
				        
				        -- We recalculate the Block Start to use as the Sort Key
				        VAR blockStart =
				             IF ( v < firstEnd, openS, start2 + idx * 3600 )
				
				        RETURN 
				            IF ( [Value] >= openS && [Value] < closeS, blockStart, 999999 ) 
				    )
				RETURN RESULT
				```

	annotation PBI_Id = b3bc12a5a32d43f89bcab2aa2b27c0e0

