table Inventory
	isHidden
	lineageTag: e6f391b9-394c-40b1-ac79-c7c55cec5d3f

	measure 'T1 Inventory' =
			
			SUMX ( 'Inventory', [Quantity On Hand T1] )
		formatString: #,0
		isHidden
		displayFolder: _Direct Measures
		lineageTag: 2365fbb3-a7ef-439f-a110-252a788ab297

	measure 'Cara Inventory' =
			
			SUMX ( 'Inventory', [Quantity On Hand Cara] )
		formatString: #,0
		isHidden
		displayFolder: _Direct Measures
		lineageTag: 5b04c7ad-c932-40ad-baf5-d54e7addb6cc

	measure 'Total Inventory' =
			
			SUMX ( 'Inventory', [Quantity On Hand T1] + [Quantity On Hand Cara] )
		formatString: #,0
		isHidden
		displayFolder: _Direct Measures
		lineageTag: 29cdd402-811e-4377-b68d-5142a919ff4b

	column 'Product Key'
