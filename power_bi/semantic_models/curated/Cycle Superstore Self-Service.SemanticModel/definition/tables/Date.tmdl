	partition '41 - Date' = calculated
		mode: import
		source = ```
				
				VAR FirstDayOfWeek = 1   -- 0 = Sunday, 1 = Monday, 
				
				// 1. Reference the latest refresh date (Fallback to TODAY() if table is momentarily empty during refresh)
				VAR LastRefreshDate = CALCULATE( MAX ( '98 - Refreshes'[Last Refresh Date] ), '98 - Refreshes'[Layer Name] = "raw_ccdata")
				
				// Strip the time component so it compares cleanly with the Calendar dates
				VAR EndYear = YEAR ( LastRefreshDate )
				VAR EndOfCalendarYear = DATE ( EndYear, 12, 31 )
				
				// 2. Start of Calendar (Ensure it defaults correctly if blank, and NEVER exceeds the EndYear)
				VAR FirstDateOfAll = MIN ( '99 - Data From'[Earliest Date] )
				VAR ParameterYear = YEAR ( FirstDateOfAll )
				
				RETURN
				ADDCOLUMNS (
				    CALENDAR ( DATE ( ParameterYear, 1, 1 ), EndOfCalendarYear ),
				
				    -- global continuous index across the whole date table
				    "Date Number",
				        INT ( [Date] - DATE ( ParameterYear, 1, 1 ) ) + 1,
				
				    /* --------------------
				       YEAR
				    -------------------- */
				    "Year", YEAR ( [Date] ),
				
				    /* --------------------
				       QUARTER / YEAR-QUARTER
				    -------------------- */
				    "Quarter Number", QUARTER ( [Date] ),                                  -- 1..4 (sort key)
				    "Quarter", "Q" & FORMAT ( QUARTER ( [Date] ), "0" ),                   -- display
				    "Day of Quarter Number",
				    INT ( [Date] - DATE ( YEAR ( [Date] ), ( QUARTER ( [Date] ) - 1 ) * 3 + 1, 1 ) ) + 1,
				
				    "Year Quarter Number", YEAR ( [Date] ) * 4 + QUARTER ( [Date] ) - 1,   -- sort key for Year Quarter
				    "Year Quarter", "Q" & FORMAT ( QUARTER ( [Date] ), "0" )
				        & "-" & FORMAT ( YEAR ( [Date] ), "0000" ),                        -- display (e.g., Q1-2026)
				
				    /* --------------------
				       WEEK (non-ISO, normal)
				    -------------------- */
				    "Week Number", WEEKNUM ( [Date], 2 ),  
				    "Week", "W" & FORMAT ( WEEKNUM ( [Date], 2 ), "00" ),
				
				    "Year Week Number",
				        ( YEAR ( [Date] ) * 53 ) + WEEKNUM ( [Date], 2 ) - 1,
				
				    "Year Week",
				        FORMAT ( YEAR ( [Date] ), "0000" )
				            & " - W" & FORMAT ( WEEKNUM ( [Date], 2 ), "00" ),
				
				    /* --------------------
				       MONTH / YEAR-MONTH
				    -------------------- */
				    "Month Number", MONTH ( [Date] ),                                      -- 1..12 (sort key)
				    "Month", FORMAT ( [Date], "mmm" ),                                     -- display
				    "Day of Month Number", DAY ( [Date] ),
				
				    "Year Month Number", YEAR ( [Date] ) * 12 + MONTH ( [Date] ) - 1,      -- index that respects last year
				    "Year Month", FORMAT ( [Date], "mmm yyyy" ),                           -- display (e.g., Jan 2026)
				    "Start of Month", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 ),
				    "End of Month", EOMONTH ( [Date], 0 ),
				
				    "Month In Quarter Number",
				        MONTH ( [Date] ) - 3 * ( QUARTER ( [Date] ) - 1 ),                 -- 1..3
				        
				    /* --------------------
				       DAY OF WEEK
				    -------------------- */
				    "Day Of Week Number",
				        WEEKDAY ( [Date], 2 ),                        -- 1..7 with FirstDayOfWeek first
				
				    "Day Of Year Number", INT ( [Date] - DATE ( YEAR ( [Date] ), 1, 1 ) ) + 1,
				
				    "Day of Week",
				        VAR Wd = WEEKDAY ( [Date], 1 ) - 1                                 -- 0=Sun..6=Sat
				        VAR WdShift = Wd + 7 * ( Wd < FirstDayOfWeek )
				        RETURN
				            SWITCH (
				                WdShift,
				                1, "Mon",
				                2, "Tue",
				                3, "Wed",
				                4, "Thu",
				                5, "Fri",
				                6, "Sat",
				                7, "Sun"
				            ),
				            
				    /* --------------------
				       INTEGRATED CALCULATED COLUMNS & GROUPS
				    -------------------- */
				  "Weekday Number", 
				        VAR CurrentDate = [Date]
				        VAR CurrentYear = YEAR ( CurrentDate )
				        VAR CurrentWeekNum = WEEKNUM ( CurrentDate, 2 )
				        
				        -- Find the Monday of the current week
				        VAR MondayOfThisWeek = CurrentDate - WEEKDAY ( CurrentDate, 2 ) + 1
				        
				        -- If it's Week 1, the week starts on Jan 1st. Otherwise, it starts on Monday.
				        VAR FirstDateOfThisWeek = 
				            IF ( CurrentWeekNum = 1, DATE ( CurrentYear, 1, 1 ), MondayOfThisWeek )
				            
				        -- Subtract the start date from the current date
				        RETURN INT ( CurrentDate - FirstDateOfThisWeek ) + 1,
				        
				    "Is Working Day", 
				        WEEKDAY ( [Date], 2 ) < 6,
				
				    "Irish Seasons",
				        IF ( 
				            MONTH ( [Date] ) IN { 1, 2, 9, 10, 11, 12 }, 
				            "Irish Winter", 
				            "Irish Summer" 
				        ),
				        
				    /* --------------------
				       COMPLETED PERIOD FLAGS
				    -------------------- */
				    
				    "Is Completed Day", 
				        [Date] <= LastRefreshDate,
				
				    "Is Completed Week", 
				        LastRefreshDate >= [Date] + ( 7 - WEEKDAY ( [Date], 2 ) ),
				
				    "Is Completed Month", 
				        LastRefreshDate >= EOMONTH ( [Date], 0 ),
				
				    "Is Completed Quarter", 
				        VAR MonthInQuarter = MOD ( MONTH ( [Date] ) - 1, 3 ) + 1 
				        RETURN LastRefreshDate >= EOMONTH ( [Date], 3 - MonthInQuarter ),
				
				    "Is Completed Year", 
				        LastRefreshDate >= DATE ( YEAR ( [Date] ), 12, 31 )
				)
				```

	annotation PBI_Id = 7fb6563c96694a398d956e7ad880f4fe

