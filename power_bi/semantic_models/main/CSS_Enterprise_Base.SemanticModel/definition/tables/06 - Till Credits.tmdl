table '06 - Till Credits'
	lineageTag: 695c4ba1-1cc5-4981-b11d-93fec98835af

	/// incl vat
	measure 'Till Credits Amount' =
			
			SUMX ( '06 - Till Credits', [Price] )
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: _Direct Measures
		lineageTag: bd0d3ceb-6c39-4c17-9da5-ccafcf067227

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Till Credits COGS' =
			
			SUMX ( '06 - Till Credits', [Cost] )
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: _Direct Measures
		lineageTag: 8b51135a-3746-4265-b388-65acceb8a15c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Till Credits Gross Loss' =
			
			SUMX ( '06 - Till Credits', [Price] - [VAT Amount] - [Cost] )
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: _Direct Measures
		lineageTag: 3a1ac30a-e1e0-420a-a94d-9139b43e95d7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Till Credits Note Count' =
			
			DISTINCTCOUNT ( '06 - Till Credits'[Transaction Key] )
		formatString: #,0
		displayFolder: _Direct Measures
		lineageTag: 56644b2b-37ba-4d6d-b76d-3434a4090bce

	measure 'Till Credits Units Credited' =
			
			SUMX ( '06 - Till Credits', [Quantity] )
		formatString: 0
		displayFolder: _Direct Measures
		lineageTag: 76014b2b-6b03-46dc-a8b4-a202ea183109

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Till Credits Amount (Excl. VAT)' =
			
			SUMX ( '06 - Till Credits', [Price] - [VAT Amount] )
		displayFolder: _Direct Measures
		lineageTag: e16b1463-9d2e-41fe-b1be-243256f81554

	measure 'Till Credits Discount Amount' =
			
			SUMX ( '06 - Till Credits', [Price Before Discount] - [Price] )
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: _Direct Measures
		lineageTag: bb0c3ba7-bcc9-4239-ace9-00ba14c2da2d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

