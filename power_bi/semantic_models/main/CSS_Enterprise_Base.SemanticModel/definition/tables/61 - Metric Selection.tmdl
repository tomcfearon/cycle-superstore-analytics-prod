table '61 - Metric Selection'
	lineageTag: 0c221baa-98e7-4f81-967a-93bc6b2b00bd

	measure 'Selected Metric' =
			
			VAR _Selected = SELECTEDVALUE('61 - Metric Selection'[Value1])
			RETURN
			    SWITCH(
			        _Selected,
			        "Ad Clicks", [Ads Clicks],
			        "Ad Impressions", [Ads Impressions],
			        "Cost Per Click (CPC)", [Cost Per Click],
			        "Cost Per Thousand Impressions (CPM)", [Cost Per Thousand Impressions (CPM)],
			        "Estimated Store Visits", [Mid Store Visits + 4 Days],
			        "Cost Per Store Visit", [Cost Per Store Visit],
			        "Purchase Count", [Purchase Count],
			        "Purchase Value", [Purchase Value],
			        BLANK()
			    )
		lineageTag: fa81f7ce-ca9e-4a0c-8123-b93c30974fb3

		formatStringDefinition =
				VAR _Selected = SELECTEDVALUE('61 - Metric Selection'[Value1])
				RETURN
				    SWITCH(
				        _Selected,
				        "Cost Per Click (CPC)", "€#,##0.00",
				        "Cost Per Thousand Impressions (CPM)", "€#,##0.00",
				        "Cost Per Store Visit", "€#,##0.00",
				        "Purchase Value", "€#,##0.00",
				        "Estimated Store Visits", "#,##0.0000", -- Formatted to 4 decimal places
				        "#,##0" -- Default format for Ad Clicks, Ad Impressions, & Purchase Count
				    )

	measure 'Dynamic Chart Title' =
			
			VAR _Selected = SELECTEDVALUE('61 - Metric Selection'[Value1])
			RETURN
			    SWITCH(
			        _Selected,
			        "Ad Clicks", "Google Ads Clicks",
			        "Ad Impressions", "Google Ads Impressions",
			        "Cost Per Click (CPC)", "Google Ads Cost Per Click",
			        "Cost Per Thousand Impressions (CPM)", "Google Ads Cost Per Thousand Impressions",
			        "Estimated Store Visits", "Google Ads Estimated Store Visits",
			        "Cost Per Store Visit", "Google Ads Cost Per Store Visit",
			        "Purchase Count", "Google Ads Purchase Count",
			        "Purchase Value", "Google Ads Purchase Value",
			        "Google Ads Metrics Overview" -- Fallback title when no single selection is made
			    )
		lineageTag: 38cfee7e-3114-41c8-aa2f-928e22d60f77

	column Value1
		lineageTag: eceb9232-685d-487a-b517-b1cd7a7f88ad
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value1]

		annotation SummarizationSetBy = Automatic

	column Value2
		lineageTag: 0a72f855-9019-4a02-8ad6-389e02a8e699
		summarizeBy: none
		isNameInferred
