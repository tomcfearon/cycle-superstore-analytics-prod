	column Value3
		formatString: 0
		lineageTag: 464504f5-d811-4cca-bdaa-fa8fe3de8910
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Value3]

		annotation SummarizationSetBy = Automatic

	partition '61 - Metric Selection' = calculated
		mode: import
		source =
				{
				    ("Ad Clicks", NAMEOF('00 - Measures'[Ads Clicks]), 1),
				    ("Ad Impressions", NAMEOF('00 - Measures'[Ads Impressions]), 2),
				    ("Cost Per Click (CPC)", NAMEOF('00 - Measures'[Cost Per Click]), 3),
				    ("Cost Per Thousand Impressions (CPM)", NAMEOF('00 - Measures'[Cost Per Thousand Impressions (CPM)]), 4),
				    ("Estimated Store Visits", NAMEOF('00 - Measures'[Mid Store Visits + 4 Days]), 5),
				    ("Cost Per Store Visit", NAMEOF('00 - Measures'[Cost Per Store Visit]), 6),
				    ("Purchase Count", NAMEOF('00 - Measures'[Purchase Count]), 7),
				    ("Purchase Value", NAMEOF('00 - Measures'[Purchase Value]), 8)
				}

	annotation PBI_Id = e866fd21de8e4830ad5ec6ab9a233daf

