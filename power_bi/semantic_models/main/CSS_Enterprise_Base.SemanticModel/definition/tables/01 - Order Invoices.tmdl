		lineageTag: 87eac7a3-0197-41a7-b69d-07ac6330b0f9

	measure 'Order Invoices Amount (Excl. VAT)' =
			
			SUMX ( '01 - Order Invoices', [Price] - [VAT Amount] )
		displayFolder: _Direct Measures
		lineageTag: 30e744a9-0ef1-4d27-b4cd-c4c9e94d2f55

	measure 'Order Invoices Discount Amount' =
			
			SUMX ( '01 - Order Invoices', [Price Before Discount] - [Price] )
