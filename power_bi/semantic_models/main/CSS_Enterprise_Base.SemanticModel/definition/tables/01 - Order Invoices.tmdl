table '01 - Order Invoices'
	lineageTag: 76dcf26b-0b7b-4c0b-9a84-c9a5b0587ea9

	measure 'Order Invoices Amount' =
			
			SUMX ( '01 - Order Invoices', [Price] )
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: _Direct Measures
		lineageTag: e2f999ee-3e63-4a73-9f26-0b31671ac418

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Order Invoices COGS' =
			
			SUMX ( '01 - Order Invoices', [Cost] )
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: _Direct Measures
		lineageTag: 4ca117fc-c5e8-45b2-8c46-2822fec4af07

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Order Invoices Customer Count' =
			
			DISTINCTCOUNT ( '01 - Order Invoices'[Customer Code] )
		formatString: #,0
		displayFolder: _Direct Measures
		lineageTag: 521cd8f0-3817-4c38-b3ff-7e59d3758513

	measure 'Order Invoices Gross Profit' =
			
			SUMX ( '01 - Order Invoices', [Price] - [VAT Amount] - [Cost] )
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: _Direct Measures
		lineageTag: 84f122ce-31e1-44ef-ae35-56381ff6da84

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Order Invoices Note Count' =
			
