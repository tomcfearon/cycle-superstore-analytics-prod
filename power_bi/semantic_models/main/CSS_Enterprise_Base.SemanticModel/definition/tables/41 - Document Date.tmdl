	column 'Is Last 12 Completed Months' = ```
			
			VAR TodayDate = TODAY()
			VAR LastCompletedMonthEnd = EOMONTH(TodayDate, -1)
			VAR Last12MonthsStart = EOMONTH(TodayDate, -13) + 1
			RETURN
			    '41 - Document Date'[Date] >= Last12MonthsStart 
			        && '41 - Document Date'[Date] <= LastCompletedMonthEnd
			```
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 5295ba42-91d2-4d08-8f35-a1917ebd24c4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Is Last 12 Completed Months 30Day Delay' = ```
			
			VAR TodayDate = TODAY()
			VAR StandardLastMonthEnd = EOMONTH(TodayDate, -1)
			
			-- Check how many days have passed since the previous month ended
			VAR DaysSinceMonthEnd = INT(TodayDate - StandardLastMonthEnd)
			
			-- If less than 30 days have passed, shift back to 2 months ago
			VAR MonthOffset = IF(DaysSinceMonthEnd >= 30, -1, -2)
			
			VAR LastCompletedMonthEnd = EOMONTH(TodayDate, MonthOffset)
			VAR Last12MonthsStart = EOMONTH(LastCompletedMonthEnd, -12) + 1
			
			RETURN
			    '41 - Document Date'[Date] >= Last12MonthsStart 
			        && '41 - Document Date'[Date] <= LastCompletedMonthEnd
			```
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: de7193ae-e1d5-44bb-b915-41252856ee53
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

