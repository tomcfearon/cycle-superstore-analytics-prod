table '15 - Google Ads Campaign Stats'
	lineageTag: 9eab3d65-a6ce-444c-9bb1-e6aaea845462

	measure 'Ads Cost' =
			SUMX(
				'15 - Google Ads Campaign Stats',
				[Total Cost]
			)
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: 1b0c4ef6-652f-4d5a-af04-f9a37d5d2519

	measure 'Bottom Funnel Cost' =
			CALCULATE(
				[Ads Cost],
				'51 - Google Ads Campaign'[Funnel Type] = "Bottom Funnel"
			)
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: a9a0ce0a-81ce-46e1-ae0c-61cde3723bb7

	measure 'Mid Funnel Cost' =
			CALCULATE(
				[Ads Cost],
				'51 - Google Ads Campaign'[Funnel Type] = "Medium Funnel"
			)
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: d8218ad8-53e7-4123-84c6-aa370af0509e

