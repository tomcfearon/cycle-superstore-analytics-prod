table '16 - Service Engineer Performance'
	lineageTag: 8f79991f-b81e-459c-b305-4a309e687135

	measure 'Bike Build Count' =
			SUMX(
				'16 - Service Engineer Performance',
				[Bike Builds]
			)
		formatString: #,0
		displayFolder: _Direct Measures
		lineageTag: b78b8896-c357-43d7-9593-06828a7fe6ca

	measure 'Bike Build Hours' =
			DIVIDE(
				SUMX(
					'16 - Service Engineer Performance',
					[Bike Build Time]
				),
				60
			)
		formatString: #,0.0
		displayFolder: _Direct Measures
		lineageTag: 1d51ac5f-bb01-432a-93c7-767f6b554136

	measure 'Floor Bike Build Count' =
