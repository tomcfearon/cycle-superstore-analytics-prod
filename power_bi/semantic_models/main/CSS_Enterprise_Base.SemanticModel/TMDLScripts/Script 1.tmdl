					VAR _ID =
					    SELECTEDVALUE ( '42 - Product'[Stock Code])
					VAR prod_type = SELECTEDVALUE('42 - Product'[Main/Sundry])
					VAR BaseURL =
					    SWITCH (
					        Mode,
					        "VPN", "http://192.168.195.210/",
					        "Internal", "http://10.1.1.4/",
					        BLANK ()
					    ) -- 2. Build the specific link depending on document type
					RETURN
					    IF (
					        ISBLANK ( BaseURL ),
					        BLANK (),
					        SWITCH (
					            TRUE (),
					            prod_type = "Main",
					                BaseURL & "Products.aspx#ID/" & _ID,
					            prod_type = "Sundry",
					                BaseURL & "Stock.aspx#ID/" & SUBSTITUTE(_ID, "/", "%23" ),
					            BLANK ()
					        )
					    )
				displayFolder: 20 - Utilities/Hidden\Links
				lineageTag: 416044fd-33bb-41e7-9f38-36d0de428cd5

