					DIVIDE ( [Sales COGS], [Average Stock Value], 0 )
				displayFolder: 05 - Inventory\Efficiency
				lineageTag: d47561fc-26d6-45a4-9f9c-a1681b1de2c0

			measure '55 - Service Bonus Calculated' =
					
					SUMX (
					    VALUES ( '44 - Employee'[Employee Name] ),
					    [Service Net Sales] * CALCULATE ( MAX ( '44 - Employee'[Bonus] ) )
					)
				formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
				displayFolder: 55 - Reconciliation Report\3 - Service by Salesperson
				lineageTag: 2dcf2c67-1091-4587-bffb-9323372dd1ee

				annotation PBI_FormatHint = {"isDecimal":true}

			measure 'Child Level List' =
					
					VAR MaxItems = 5
					RETURN
					    SWITCH (
					        TRUE (),
					        -- 1. If at Subcategory level (bottom), show nothing (or you could show related brands)
					        ISINSCOPE ( '42 - Product'[Subcategory] ), BLANK (),
					        -- 2. If at Category level, show top 5 Subcategories
					        ISINSCOPE ( '42 - Product'[Category] ),
					            VAR SubCatCount =
					                DISTINCTCOUNT ( '42 - Product'[Subcategory] )
					            VAR TopSubCats =
					                CONCATENATEX (
					                    TOPN ( MaxItems, VALUES ( '42 - Product'[Subcategory] ) ),
					                    '42 - Product'[Subcategory],
					                    ", "
					                )
					            RETURN
					                IF ( SubCatCount > MaxItems, TopSubCats & " and more...", TopSubCats ),
					        -- 3. If at Cat Type level, show top 5 Categories
					        ISINSCOPE ( '42 - Product'[Category Type] ),
					            VAR CatCount =
					                DISTINCTCOUNT ( '42 - Product'[Category] )
					            VAR TopCats =
					                CONCATENATEX (
					                    TOPN ( MaxItems, VALUES ( '42 - Product'[Category] ) ),
					                    '42 - Product'[Category],
					                    ", "
					                )
					            RETURN
					                IF ( CatCount > MaxItems, TopCats & " and more...", TopCats ),
					        BLANK ()
					    )
				formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
				displayFolder: 51 - Gross Profit Report\4_Product
				lineageTag: de5498e2-bb01-4715-a7db-ab4ede3dbff7

			measure 'Estimated In-Store Retail Profit YTD Change (Last Week Filtered)' =
					
					VAR LatestWeekFiltered =
					    CALCULATE ( MAX ( '41 - Document Date'[Week] ), ALLSELECTED ( '41 - Document Date' ) )
					VAR CurrentWeekInContext =
					    SELECTEDVALUE ( '41 - Document Date'[Week] )
					RETURN
					    IF (
					        CurrentWeekInContext = LatestWeekFiltered,
					        [Retail Gross Profit YTD CY (Order Date)] + [Retail Orders Gross Profit (.80 Weighting)] - [Retail Gross Profit YTD LY (Order Date)],
					        BLANK ()
					    )
				formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
				displayFolder: 51 - Gross Profit Report\3_Retail Sales Order Date
				lineageTag: 97d8ae5d-41c2-4734-9fcc-8b1fd264434a

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure '55 - Qty Invoice Orders' =
					
					COALESCE (
					    DISTINCTCOUNT ( '01 - Order Invoices'[Transaction Key] )
					        + DISTINCTCOUNT ( '05 - Order Credits'[Transaction Key] )
					        + DISTINCTCOUNT ( '07 - Service Credits'[Transaction Key] ),
					    --erp has a bug showing servcredits,
					    0
					)
				formatString: #,0
				displayFolder: 55 - Reconciliation Report\6 - Transactions Report
				lineageTag: 690457a6-705f-4cc4-bfc7-99d1c2cf0b02

			/// ERP counts one row per SundryHeader document.
			/// A partially-credited doc appears in BOTH Till Invoices and Till Credits.
			/// UNION de-duplicates so each document is counted once.
			measure '55 - Qty Till Transactions' =
					
					COALESCE (
					    COUNTROWS (
					        DISTINCT (
					            UNION (
					                VALUES ( '02 - Till Invoices'[Transaction Key] ),
					                VALUES ( '06 - Till Credits'[Transaction Key] )
					            )
					        )
					    ),
					    0
					)
				formatString: #,0
				displayFolder: 55 - Reconciliation Report\6 - Transactions Report
				lineageTag: 9c1b81cb-cd36-493e-afd2-be8dd3f747ce

			/// ERP counts ALL Repairs rows by FaultDate.
			/// Service Invoices = invoiced repairs (switch to Order Date = FaultDate).
			/// Service Orders = uninvoiced repairs (Order Date = FaultDate is active).
			/// Service Credits are InvoiceHeader records — already counted in Qty Invoice.
			measure '55 - Qty Service Orders' =
					
					COALESCE (
					    CALCULATE (
					        DISTINCTCOUNT ( '03 - Service Invoices'[Order Number] ),
					        USERELATIONSHIP ( '03 - Service Invoices'[Order Date], '41 - Document Date'[Date] )
					    )
					        + DISTINCTCOUNT ( '09 - Service Orders'[Transaction Key] ),
					    0
					)
				formatString: 0
				displayFolder: 55 - Reconciliation Report\6 - Transactions Report
				lineageTag: 6703c52e-875b-412f-98ef-89819ed9f335

			measure 'CCData Last Refresh UTC' =
					
					CALCULATE (
					    MAX ( '98 - Refreshes'[Last Refresh UTC] ),
					    REMOVEFILTERS ( '41 - Document Date' ),
					    '98 - Refreshes'[Layer Name] = "raw_ccdata",
					         '98 - Refreshes'[Table Name] <> "raw_ccdata.Inventory"
					)
				formatString: General Date
				displayFolder: 20 - Utilities/Hidden\Refreshes
				lineageTag: 221d5981-4fa8-4c20-aa0d-d1436a11a8e6

			measure 'Inventory Last Refresh UTC' =
					
					CALCULATE (
					    MAX ( '98 - Refreshes'[Last Refresh UTC] ),
					    REMOVEFILTERS ( '41 - Document Date' ),
					    '98 - Refreshes'[Table Name] = "raw_ccdata.inventory"
					)
				formatString: General Date
				displayFolder: 20 - Utilities/Hidden\Refreshes
				lineageTag: 696487f0-2dbe-43fc-9447-e4d5af7abb86

			measure '55 - Stock Value' =
					
					-- Physical bikes: Quantity On Hand T1 already includes ItemType-6 reserved bikes.
					-- Physical sundry: sum T1 + T2 + Cara, exclude Labour Charges.
					VAR _PhysicalStock =
					    SUMX (
					        FILTER ( '42 - Product', '42 - Product'[Subcategory] <> "Labour Charges" ),
					        ( [Quantity On Hand Cara] + [Quantity On Hand T1] + [Quantity On Hand T2] )
					            * IF ( '42 - Product'[Main/Sundry] = "Main", [Cost Price], [Average Cost Price] )
					    ) -- Sundry on open Sales Orders (QtyTaken * AveCostPrice, exclude Labour Charges)
					-- Bikes on SO are already counted in dim_stock quantities (ItemType=6 rows).
					VAR _SundryOpenSalesOrders =
					    CALCULATE (
					        SUMX (
					            FILTER (
					                '08 - Sales Orders',
					                RIGHT ( '08 - Sales Orders'[Product Key], 2 ) = "-0"
					                    && RELATED ( '42 - Product'[Subcategory] ) <> "Labour Charges"
					            ),
					            '08 - Sales Orders'[Quantity Taken]
					                * RELATED ( '42 - Product'[Average Cost Price] )
					        ),
					        REMOVEFILTERS ( '41 - Document Date' )
					    ) -- Sundry on open Service Jobs (uninvoiced only).
					VAR _SundryOpenServiceJobs =
					    CALCULATE (
					        SUMX (
					            FILTER (
					                '09 - Service Orders',
					                RIGHT ( '09 - Service Orders'[Product Key], 2 ) = "-0"
					                    && RELATED ( '42 - Product'[Subcategory] ) <> "Labour Charges"
					            ),
					            '09 - Service Orders'[Quantity] * RELATED ( '42 - Product'[Average Cost Price] )
					        ),
					        REMOVEFILTERS ( '41 - Document Date' )
					    )
					RETURN
					    _PhysicalStock + _SundryOpenSalesOrders + _SundryOpenServiceJobs
				formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
				displayFolder: 55 - Reconciliation Report\2 - Sale By Make
				lineageTag: 7a07f491-8a01-4b83-b1c7-73e4a229ed9a

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Inventory Last Refresh (Text)' =
					
					VAR _LatestRefresh = [Inventory Last Refresh UTC]
					RETURN
					    IF (
					        ISBLANK ( _LatestRefresh ),
					        "No Data",
					        "Last Refreshed: " & FORMAT ( _LatestRefresh, "dd/mm/yy HH:mm" ) & " UTC"
					    )
				displayFolder: 20 - Utilities/Hidden\Display Text\Refreshes
				lineageTag: 584aab4e-02be-4f3e-adb8-616e23e0120c

			measure SelectionMessage =
					
					IF (
					    ISFILTERED ( '42 - Product'[ERP Brand] ),
					    BLANK (),
					    "Select a brand to filter"
					)
				displayFolder: 55 - Reconciliation Report\5 - Stock - Makes
				lineageTag: 4db7f83d-b296-4ca1-8595-c8052ebce23a

			measure OverlayBackground =
					
					IF (
					    ISFILTERED ( '42 - Product'[ERP Brand] ),
					    "#FFFFFF00",
					    // Transparent (disappears)
					    "#FFFFFF" // Solid White (hides the table)
					)
				displayFolder: 55 - Reconciliation Report\5 - Stock - Makes
				lineageTag: e4011336-c6f3-49ac-bcd2-4e20b556c400

			measure OverlayText =
					
					IF (
					    ISFILTERED ( '42 - Product'[ERP Brand] ),
					    "#FFFFFF00",
					    // Transparent (disappears)
					    "#000000" // Solid Black (or whatever color you want your message)
					)
				displayFolder: 55 - Reconciliation Report\5 - Stock - Makes
				lineageTag: f8a5931a-8ddc-4c43-b2e5-aebeb1371248

			measure '55 - P5' =
					
					VAR _total = [Repair Hours] + [Floor Bike Build Hours] + [Bike Build Hours] + [Bike Build Count] + [Floor Bike Build Count]
					RETURN
					    IF ( _total <> 0, 1, 0 )
				displayFolder: 55 - Reconciliation Report\0 - Visual Filters
				lineageTag: c13e7946-4613-4636-bc58-aaffb40ac23a

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Google Last Refresh UTC' =
					
					CALCULATE (
					    MAX ( '98 - Refreshes'[Last Refresh UTC] ),
					    REMOVEFILTERS ( '41 - Document Date' ),
					    '98 - Refreshes'[Layer Name] = "raw_google"
					)
				formatString: General Date
				displayFolder: 20 - Utilities/Hidden\Refreshes
				lineageTag: ebdf702f-3c5a-4afc-ba70-675124d3ee7c

			measure 'Google Last Refresh (Text)' =
					
					VAR _LatestRefresh = [Google Last Refresh UTC]
					RETURN
					    IF (
					        ISBLANK ( _LatestRefresh ),
					        "No Data",
					        "Last Refreshed: " & FORMAT ( _LatestRefresh, "dd/mm/yy HH:mm" ) & " UTC"
					    )
				displayFolder: 20 - Utilities/Hidden\Display Text\Refreshes
				lineageTag: 54f86583-3cb8-4e8a-a22a-9c787d81e669

			measure '55 - Revenue' =
					
					IF (
					    ISINSCOPE ( '44 - Employee'[Employee Name] ),
					    [55 - Order Revenue (Non Collections)] + [55 - Order Revenue (Collections)] + [Till Net Sales],
					    [55 - Non Collections] + [55 - Collections] + [55 - Till Revenue (ERP Visual)]
					)
				formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
				displayFolder: 55 - Reconciliation Report\1 - Sale by Salesperson
				lineageTag: 3f40b5a2-5a03-4652-8d3d-393496f3db11

			measure '55 - Non Collections' =
					
					IF (
					    ISINSCOPE ( '44 - Employee'[Employee Name] ),
					    [55 - Order Revenue (Non Collections)],
					    VAR EmployeeKeys =
					        DISTINCT (
					            UNION (
					                SELECTCOLUMNS (
					                    VALUES ( '01 - Order Invoices'[Employee Key] ),
					                    "employee_key", '01 - Order Invoices'[Employee Key]
					                ),
					                SELECTCOLUMNS (
					                    VALUES ( '05 - Order Credits'[Employee Key] ),
					                    "employee_key", '05 - Order Credits'[Employee Key]
					                )
					            )
					        )
					    RETURN
					        SUMX (
					            EmployeeKeys,
					            VAR EmployeeKey = [employee_key]
					            VAR InvoiceAmount =
					                CALCULATE (
					                    [Order Invoices Amount],
					                    KEEPFILTERS ( '01 - Order Invoices'[Collection Employee Key] = -1 ),
					                    KEEPFILTERS ( '01 - Order Invoices'[Employee Key] = EmployeeKey )
					                )
					            VAR CreditAmount =
					                CALCULATE (
					                    [Order Credits Amount],
					                    KEEPFILTERS ( '05 - Order Credits'[Collection Employee Key] = -1 ),
					                    KEEPFILTERS ( '05 - Order Credits'[Employee Key] = EmployeeKey )
					                )
					            RETURN
					                InvoiceAmount - CreditAmount
					        )
					)
				formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
				displayFolder: 55 - Reconciliation Report\1 - Sale by Salesperson
				lineageTag: c5321e69-92e5-44ab-a5d6-34b7af2362bd

			measure '55 - Collections' =
					
					IF (
					    ISINSCOPE ( '44 - Employee'[Employee Name] ),
					    [55 - Order Revenue (Collections)],
					    SUMX (
					        VALUES ( '44 - Employee'[Employee Key] ),
					        CALCULATE ( [55 - Order Revenue (Collections)] )
					    )
					)
				formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
				displayFolder: 55 - Reconciliation Report\1 - Sale by Salesperson
				lineageTag: 3880ce75-9411-4c53-a39a-0fb9ea977593

			measure '55 - Collections Made' =
					
					IF (
					    ISINSCOPE ( '44 - Employee'[Employee Name] ),
					    [55 - Order Revenue],
					    SUMX (
					        VALUES ( '44 - Employee'[Employee Key] ),
					        CALCULATE ( [55 - Order Revenue] )
					    )
					)
				formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
				displayFolder: 55 - Reconciliation Report\1 - Sale by Salesperson
				lineageTag: 8e6b8cdb-8d87-4d6f-b4fb-c6a2547ca89e

			measure '55 - P3' =
					
					VAR _total = [Service Net Sales] + [Service Gross Profit] + [Service Net COS] + [55 - Service Bonus Calculated]
					RETURN
					    IF ( NOT ISBLANK ( _total ) && _total <> 0, 1, 0 )
				formatString: 0
				displayFolder: 55 - Reconciliation Report\0 - Visual Filters
				lineageTag: dc8ccbbb-db3d-4736-9594-f29a9892ab59

			measure '55 - Service Invoices COGS' =
					
					SUMX (
					    '03 - Service Invoices',
					    VAR _invoice_cost = [Cost]
					    VAR _stock_key = [Product Key] -- Labour-* and MISC-3 are synthetic/non-stock items; skip stock cost lookup for these
					    VAR _is_synthetic =
					        LEFT ( _stock_key, 6 ) = "Labour" || _stock_key = "MISC-3" -- Fallback: current stock cost price × qty, to match ERP behaviour for zero-cost invoice lines
					    VAR _stock_cost =
					        COALESCE ( RELATED ( '42 - Product'[Cost Price] ), 0 ) * [Quantity]
					    RETURN
					        IF ( _invoice_cost = 0 && NOT _is_synthetic, _stock_cost, _invoice_cost )
					)
				formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
				displayFolder: 55 - Reconciliation Report\3 - Service by Salesperson
				lineageTag: a035fcd4-3d3e-4011-8efe-35b097bdfd9f

			measure '55 - Service Net COS' =
					
					[55 - Service Invoices COGS] - [Service Credit COS]
				formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
				displayFolder: 55 - Reconciliation Report\3 - Service by Salesperson
				lineageTag: 417885fe-942e-4ad9-989c-340cc3f4d5f2

			measure 'Sales Value' =
					
					[Sales Invoice Amount] - [Sales Credit Amount]
				formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
				displayFolder: 02 - Sales\_Totals\‏‏_Net
				lineageTag: 9a31fbc7-20ab-4f32-81d3-3cc1ecd24098

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Sales Units Sold' =
					
					[Sales Units Invoiced] - [Sales Units Credited]
				formatString: #,0
				displayFolder: 02 - Sales\_Totals\‏‏_Net
				lineageTag: 743f1831-d1f0-40f7-8119-500cafa673d6

			measure 'Sales COGS' =
					
					[Sales Invoice COGS] - [Sales Credit COGS]
				formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
				displayFolder: 02 - Sales\_Totals\‏‏_Net
				lineageTag: 3606a5d2-4508-4634-8118-f053825ccd99

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Sales Invoices' =
					
