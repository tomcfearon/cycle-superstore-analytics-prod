					    KEEPFILTERS ( '01 - Order Invoices'[Is Credited] = FALSE ),
					    KEEPFILTERS ( '01 - Order Invoices'[Price] <> 0 ),
					    KEEPFILTERS ( '01 - Order Invoices'[Product Key] <> "MISC-3" )
					)
				formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
				displayFolder: 55 - Reconciliation Report\2 - Sale By Make
