				annotation PBI_FormatHint = {"currencyCulture":"en-IE"}

			measure '55 - Total Value Service Orders' =
					
					VAR _invoiced =
					    CALCULATE (
					        [Service Invoice Amount],
					        USERELATIONSHIP ( '03 - Service Invoices'[Order Date], '41 - Document Date'[Date] )
					    )
					VAR _orders =
					    SUM ( '09 - Service Orders'[Price] )
					RETURN
					    COALESCE ( _invoiced, 0 ) + COALESCE ( _orders, 0 )
				formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
				displayFolder: 55 - Reconciliation Report\6 - Transactions Report
