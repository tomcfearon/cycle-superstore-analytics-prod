				lineageTag: f2ee4f96-09ba-411f-9080-91b080878e50

			measure 'Unit Price (Discontinued, Ignore Model Year)' =
					
					CALCULATE (
					    MAX ( '42 - Product'[Cost Price] ),
					    KEEPFILTERS ( '42 - Product'[Is Discontinued] = TRUE () ),
					    REMOVEFILTERS ( '42 - Product'[Model Year] )
					)
				formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
				displayFolder: 52 - Order Planner
				lineageTag: c23bdd73-66d4-4e98-90c2-e6fdd7800046

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Count Of Products' =
					
					COUNTROWS ( VALUES ( '42 - Product'[Title] ) )
				formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
