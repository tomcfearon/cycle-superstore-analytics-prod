			measure '57 - Selected Sale Price' = ```
					
					// 1. Harvest the discount. Default to -0.01 ("No Discount") if nothing is selected.
					VAR _AddedDisc = SELECTEDVALUE('70 - Discount Parameter'[Value], -0.01)
					
					// 2. Calculate the standard Average Sale Price (Reality)
					VAR _BaseSalePrice = 
					    CALCULATE ( 
					        AVERAGE('42 - Product'[Sale Price]), 
					        FILTER('42 - Product', 
					            [57 - Stock On Hand (Remove Filter)] > 0 && 
					            NOT ISBLANK('42 - Product'[Sale Price]) && 
					            '42 - Product'[Sale Price] > 0
					        )
					    )
					
					// 3. Grab your RRP anchor
					VAR _RRP = [57 - Selected Retail Price] 
					
					// 4. Determine the intended sale price based on the slicer
					VAR _IntendedSalePrice = 
					    IF (
					        _AddedDisc < 0, 
					        _BaseSalePrice,             // If "No Discount" (-0.01) is chosen, show reality
					        _RRP * (1 - _AddedDisc)     // If 0% or higher is chosen, apply it to the RRP
					    )
					
					// 5. Output Logic with the Blank Guard
					RETURN
					    IF (
					        ISINSCOPE('42 - Product'[Product Model]) || ISINSCOPE('42 - Product'[Product Group ID])|| ISINSCOPE('42 - Product'[Clean Product Name]),
					        IF (
					            _IntendedSalePrice = _RRP,
					            BLANK(),
					            _IntendedSalePrice
					        )
					    )
					```
				formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
				displayFolder: 57 - Products Report\Workbook
				lineageTag: f694d33e-b34a-45e7-a228-57006a15150c

			measure '57 - Selected Trade Sale Price' = ```
					
					// 1. Harvest the trade discount. Default to -0.01 ("No Discount") if nothing is selected.
					VAR _AddedDisc = SELECTEDVALUE('71 - Discount Parameter'[Value], -0.01)
					
					// 2. Calculate the standard Average Trade Sale Price (Reality)
					VAR _BaseSalePrice = 
					    CALCULATE ( 
					        AVERAGE('42 - Product'[Trade Sale Price]), 
					        FILTER('42 - Product', 
					            [57 - Stock On Hand (Remove Filter)] > 0 && 
					            NOT ISBLANK('42 - Product'[Trade Sale Price]) && 
					            '42 - Product'[Trade Sale Price] > 0
					        )
					    )
					
					// 3. Grab your Trade anchor 
					VAR _TradeAnchor = [57 - Selected Trade Price 7]
					
					// 4. Determine the intended sale price based on the slicer
					VAR _IntendedSalePrice = 
					    IF (
					        _AddedDisc < 0, 
					        _BaseSalePrice,                 // If "No Discount" (-0.01) is chosen, show reality
					        _TradeAnchor * (1 - _AddedDisc) // If 0% or higher is chosen, apply it to the Trade Price
					    )
					
					// 5. Output Logic with the Blank Guard
					RETURN
					    IF (
					        ISINSCOPE('42 - Product'[Product Model]) || ISINSCOPE('42 - Product'[Product Group ID])|| ISINSCOPE('42 - Product'[Clean Product Name]),
					        IF (
					            _IntendedSalePrice = _TradeAnchor,
					            BLANK(),
					            _IntendedSalePrice
					        )
					    )
					```
				formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
