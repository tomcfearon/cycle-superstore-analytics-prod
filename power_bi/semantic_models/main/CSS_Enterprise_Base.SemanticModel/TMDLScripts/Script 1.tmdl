			measure 'Sales Gross Margin %' =
					
					DIVIDE ( [Sales Gross Profit], [Sales Value (Excl. VAT)] )
				formatString: 0.00%;-0.00%;0.00%
				displayFolder: 02 - Sales\Ratios & Rates
				lineageTag: f18b3478-656d-4fcf-9ec6-3e60be1534c5

			measure 'Average Sales Transaction Value (ATV)' =
					
					DIVIDE ( [Sales Value], [Sales Invoices], 0 )
				displayFolder: 02 - Sales\Ratios & Rates
				lineageTag: 9811a307-30c7-4d97-9a66-03b32575410b

			measure 'Sales Units Per Transaction (UPT)' =
					
