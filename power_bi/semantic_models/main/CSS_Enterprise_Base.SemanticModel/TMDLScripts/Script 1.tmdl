					        MAX( '41 - Document Date'[Year] ),
					        '41 - Document Date'[Date] = last
					    ) 
					
					VAR ck = IF(Last_Year = BLANK(), "Never Purchased", Last_Year)
					
					RETURN
					IF(ISINSCOPE('42 - Product'[Product Model])|| ISINSCOPE('42 - Product'[Clean Product Name]),
					    ck)
					
