			measure '57 - Trade Discount %' = ```
					
					VAR _Retail = [57 - Selected Trade Price 7]
					VAR _Sale   = [57 - Selected Trade Sale Price]
					
					// 1. Check if the product actually has a valid, discounted sale price
					VAR _IsDiscounted = 
					    NOT ISBLANK(_Sale) && 
					    _Sale > 0 && 
					    _Sale < _Retail
					
					// 2. Calculate the discount percentage: (RRP - Sale) / RRP
					VAR _DiscountPct = 
					    IF (
					        _IsDiscounted,
					        DIVIDE ( _Retail - _Sale, _Retail )
					    )
					
					// 3. Output Logic
					RETURN
					    IF (
					        ISINSCOPE('42 - Product'[Product Model]) || ISINSCOPE('42 - Product'[Product Group ID])|| ISINSCOPE('42 - Product'[Clean Product Name]),
					        _DiscountPct
					    )
					```
				formatString: 0.0%;-0.0%;0.0%
