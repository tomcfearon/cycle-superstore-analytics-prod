			measure '57 - Selected Retail Profit/Loss' = ```
					
					VAR _Retail = [57 - Selected Retail Price]
					VAR _Sale   = [57 - Selected Sale Price]
					VAR _Cost   = [57 - Selected Cost Price] 
					
					// 1. Determine the effective selling price (First non-blank value)
					VAR _EffectivePrice = COALESCE(_Sale, _Retail)
					
					// 2. Remove 23% VAT from the effective price
					VAR _EffectivePriceExVat = DIVIDE(_EffectivePrice, 1.23)
					
					// 3. Calculate Profit/Loss
					VAR _ProfitLoss = 
					    IF (
					        NOT ISBLANK(_EffectivePrice) && NOT ISBLANK(_Cost),
					        _EffectivePriceExVat - _Cost
					    )
					
					// 4. Output Logic
					RETURN
					    IF (
					        ISINSCOPE('42 - Product'[Product Model]) || ISINSCOPE('42 - Product'[Product Group ID])|| ISINSCOPE('42 - Product'[Clean Product Name]),
					        _ProfitLoss
					    )
					```
