			measure 'Sales Credit Amount (Excl. VAT)' =
					
					[Order Credits Amount (Excl. VAT)] + [Till Credits Amount (Excl. VAT)]
				displayFolder: 02 - Sales\_Totals\Credits
				lineageTag: 1166c313-757c-4204-93bf-8173f30e1d22

			measure 'Sales Invoice Amount (Excl. VAT)' =
					
					[Order Invoices Amount (Excl. VAT)] + [Till Invoices Amount (Excl. VAT)]
				displayFolder: 02 - Sales\_Totals\‎‎‎‎‎‎‎‏‏‎In‎‎voices
