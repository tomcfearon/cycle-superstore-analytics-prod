			measure 'Retail Orders Gross Profit (.80 Weighting)' =
					
					VAR MaxVisibleDate =
					    CALCULATE( MAX ( '41 - Document Date'[Date] ), '41 - Document Date'[Is Completed Week])
					RETURN
					    CALCULATE (
					        [Sales Orders Gross Profit] * 0.8,
					        '41 - Document Date'[Date] < MaxVisibleDate,
					        '43 - Customer'[Retail/Trade] = "Retail"
					    )
				formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
