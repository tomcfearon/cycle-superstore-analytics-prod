			measure 'Transaction URL SKU' = ```
					
					VAR Mode =
					    SELECTEDVALUE ( '62 - Link Mode'[Mode], "Internal" )
					VAR BaseURL =
					    SWITCH (
					        Mode,
					        "VPN", "http://192.168.195.210/",
					        "Internal", "http://10.1.1.4/",
					        BLANK ()
					    )
					
					RETURN
					    IF (
					        ISBLANK ( BaseURL ),
					        BLANK (),
					                BaseURL & "Stock.aspx#ID/" & SELECTEDVALUE('42 - Product'[Stock Code])
					    )
					
					```
				displayFolder: 20 - Utilities/Hidden\Links
				lineageTag: 833f5878-3932-4973-bc9a-e6b87ddeaf04

			measure 'Services URLs' = ```
					
					VAR Mode =
					    SELECTEDVALUE ( '62 - Link Mode'[Mode], "Internal" )
					
					-- Define your target types to keep the code clean
					VAR ValidTypes = { "Service Invoice", "Service Credit" }
					
					-- Safely resolve DocType: Ignores overlapping irrelevant types
					VAR DocType =
					    CALCULATE (
					        SELECTEDVALUE ( '47 - Transaction'[Document Type] ),
					        KEEPFILTERS ( '47 - Transaction'[Document Type] IN ValidTypes )
					    )
					
					-- Safely resolve DocNum: Ignores overlapping irrelevant types
					VAR DocNum =
					    CALCULATE (
					        SELECTEDVALUE ( '47 - Transaction'[Document Number] ),
					        KEEPFILTERS ( '47 - Transaction'[Document Type] IN ValidTypes )
					    )
					
					VAR ServNum =
					    SELECTEDVALUE ( '03 - Service Invoices'[Order Number] )
					
					VAR BaseURL =
					    SWITCH (
					        Mode,
					        "VPN", "http://192.168.195.210/",
					        "Internal", "http://10.1.1.4/",
					        BLANK ()
					    ) 
					
					-- Build the specific link depending on the document type
					RETURN
					    IF (
					        ISBLANK ( BaseURL ),
					        BLANK (),
					        SWITCH (
					            TRUE (),
					            DocType = "Service Invoice",
					                BaseURL & "Service.aspx#ID/" & SUBSTITUTE ( ServNum, "/", "%2F" ),
					            DocType = "Service Credit",
					                BaseURL & "CreditNote.aspx#ID/" & SUBSTITUTE ( DocNum, "/", "%2F" ),
					            BLANK ()
					        )
					    )
					```
				displayFolder: 20 - Utilities/Hidden\Links
				lineageTag: e8e50a57-4162-4276-8f9a-a3a31a017b70

