			measure 'Sales Value YoY' =
					
					[Sales Value] - [Sales Value LY]
				displayFolder: 02 - Sales\Variances
				lineageTag: 225710ba-d6d0-489f-95bb-a9d38db5c48c

			measure 'Sales Value YoY %' =
					
					DIVIDE ( [Sales Value YoY], [Sales Value LY], 0 )
				displayFolder: 02 - Sales\Variances
				lineageTag: aeec85d7-39a8-4cb7-bb90-f68d509d70e5

			measure 'Stock On Hand' =
					
					VAR AbsoluteLatestDate =
					    CALCULATE (
					        MAX ( '10 - Inventory'[Query Date] ),
					        REMOVEFILTERS ( '10 - Inventory' )
					    )
					VAR TotalInventory =
					    CALCULATE (
					        [Total Inventory],
					        '10 - Inventory'[Query Date] = AbsoluteLatestDate
					    )
					RETURN
					    IF ( TotalInventory = 0, BLANK (), TotalInventory )
				formatString: #,0
				displayFolder: 05 - Inventory\_Balances
				lineageTag: 26823e7e-88f1-4b9c-9d00-189f7e5be701

			measure 'T1 Stock On Hand' =
					
					VAR AbsoluteLatestDate =
					    CALCULATE (
					        MAX ( '10 - Inventory'[Query Date] ),
					        REMOVEFILTERS ( '10 - Inventory' )
					    )
					VAR TotalInventory =
					    CALCULATE ( [T1 Inventory], '10 - Inventory'[Query Date] = AbsoluteLatestDate )
					RETURN
					    IF ( TotalInventory = 0, BLANK (), TotalInventory )
				formatString: #,0
				displayFolder: 05 - Inventory\_Balances
				lineageTag: 38f0f5b0-7619-439d-9b5c-07dd1d287ef0

			measure 'Cara Stock On Hand' =
					
					VAR AbsoluteLatestDate =
					    CALCULATE (
					        MAX ( '10 - Inventory'[Query Date] ),
					        REMOVEFILTERS ( '10 - Inventory' )
					    )
					VAR TotalInventory =
					    CALCULATE (
					        [Cara Inventory],
					        '10 - Inventory'[Query Date] = AbsoluteLatestDate
					    )
					RETURN
					    IF ( TotalInventory = 0, BLANK (), TotalInventory )
				formatString: 0
				displayFolder: 05 - Inventory\_Balances
				lineageTag: 6ac35f87-657f-4cdd-9195-e9cc29b813bb

			measure 'Stock Units' =
					
					VAR LastAvailableDate =
					    LASTDATE ( '41 - Document Date'[Date] )
					RETURN
					    CALCULATE (
					        [Total Inventory],
					        '10 - Inventory'[Query Date] = LastAvailableDate
					    )
				displayFolder: 05 - Inventory\Historical Trends
				lineageTag: 2d9b8637-9ce8-49dc-87b9-0820ff7ec370

			/// current sale price value
			measure 'Stock Sale Value' =
					
					VAR LastAvailableDate =
					    LASTDATE ( '41 - Document Date'[Date] )
					RETURN
					    CALCULATE (
					        SUMX ( '42 - Product', [Total Inventory] * '42 - Product'[Selling Price 1] ),
					        '10 - Inventory'[Query Date] = LastAvailableDate
					    )
				displayFolder: 05 - Inventory\Valuations
				lineageTag: ac9ce170-20f3-435e-bb4e-59437097703a

			measure 'Average Stock Value' =
					
					AVERAGEX ( VALUES ( '41 - Document Date'[Date] ), [57 -Stock Cost Value] )
				displayFolder: 05 - Inventory\Valuations
				lineageTag: 23a81e73-bfec-4431-a177-1ab47d0f1d3a

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Days Sales of Inventory (DSI)' =
					
					DIVIDE ( [57 -Stock Cost Value], [Sales COGS], 0 ) * 365
				displayFolder: 05 - Inventory\Efficiency
				lineageTag: 921f6bb8-e41f-4127-9e42-0cf5534163be

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Estimated Net Stock Value ' =
					
					[Stock Sale Value] * ( 1 - [Sales Discount Rate %] )
				displayFolder: 05 - Inventory\Valuations
				lineageTag: 32228b59-6fea-4bc3-a0a9-8885118487aa

			measure 'Service Value' =
					
					[Service Invoice Amount] - [Service Credit Amount]
