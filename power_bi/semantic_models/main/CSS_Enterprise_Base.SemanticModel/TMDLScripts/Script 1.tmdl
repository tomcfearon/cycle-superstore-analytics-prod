			measure 'Web Product URL' = ```
					
					// Determine which website is currently selected in the report
					VAR _SelectedWebsite = SELECTEDVALUE('69 - Website'[Website])
					
					// ==========================================
					// 1. CARATRADE LOGIC
					// ==========================================
					VAR _ProductGroupID = MIN('42 - Product'[Product Group ID])
					
					// Grab the distribution flag for the current context
					VAR _IsDistribution = SELECTEDVALUE('42 - Product'[Is Distribution]) 
					
					VAR _CaratradeURL = 
					    IF (
					        // Only generate the URL if we have an ID AND the distribution flag is True
					        NOT ISBLANK(_ProductGroupID) && _IsDistribution = TRUE(),
					        "https://www.caratrade.com/shop/pc/viewPrd.asp?idproduct=" & _ProductGroupID,
					        BLANK() // Blanks out if Is Distribution is False, or if at Grand Total
					    )
					
					// ==========================================
					// 2. CSS LOGIC
					// ==========================================
					VAR _SingleLink = SELECTEDVALUE('42 - Product'[Web Link])
					VAR _ProductModel = SELECTEDVALUE('42 - Product'[Product Model])
					VAR _FormattedKeywords = SUBSTITUTE(_ProductModel, " ", "+")
					VAR _SearchURL = "https://www.cyclesuperstore.ie/productList?Keywords=" & _FormattedKeywords & "&sort=PriceASC&withstock=1"
					
					VAR _CSS_URL = 
					IF(ISBLANK(_ProductGroupID), BLANK(),
					    IF (
					        NOT ISBLANK(_SingleLink),
					        _SingleLink,
					        IF (
					            NOT ISBLANK(_ProductModel),
					            _SearchURL,
					            BLANK()
					        )
					    )
					)
					// ==========================================
					// 3. FINAL OUTPUT
					// ==========================================
					RETURN
					    IF (
					        _SelectedWebsite = "Caratrade",
					        _CaratradeURL,
					        _CSS_URL // Defaults to CSS logic if "CSS" is selected, or if nothing is selected
					    )
					```
				displayFolder: 20 - Utilities/Hidden\Links
				lineageTag: c0b4b01f-12df-44b3-a58c-bf69550db988

