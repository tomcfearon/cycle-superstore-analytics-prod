				lineageTag: 25514c44-1d82-4198-9c99-a393d881aeba

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Count Of New Products' =
					
					CALCULATE (
					    COUNTROWS ( VALUES ( '42 - Product'[Title] ) ),
					    '42 - Product'[Is New] = TRUE ()
					)
				formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
				displayFolder: 52 - Order Planner\Base
				lineageTag: 8b5f51a1-5c43-49ab-9464-6e4b5d3976c7

			measure 'Product Status' =
					
					IF (
					    ISINSCOPE ( '42 - Product'[Title] ),
					    VAR IsNew =
					        COALESCE ( SELECTEDVALUE ( '42 - Product'[Is New] ), FALSE () )
					    VAR SelMY =
					        SELECTEDVALUE ( '67 - Model Year Selector'[Model Year] )
					    VAR ThisMY =
					        CALCULATE ( MAX ( '42 - Product'[Model Year] ) )
					    RETURN
					        SWITCH (
					            TRUE (),
					            IsNew, "New Product",
					            NOT ISBLANK ( SelMY ) && NOT ISBLANK ( ThisMY ) && ThisMY <> SelMY, "Discontinued",
					            "Current Product"
					        )
					)
				displayFolder: 52 - Order Planner
				lineageTag: 96568cd9-901a-497e-96cb-9dd977759ffe

				annotation PBI_FormatHint = {"isText":true}

			measure 'Debug New Product' =
					
					"SelectedValue: "
					    & COALESCE ( FORMAT ( SELECTEDVALUE ( '42 - Product'[Is New] ), "" ), "<blank>" )
				displayFolder: 52 - Order Planner
				lineageTag: eb792bb7-9e52-4e66-8783-89985637fa99

				annotation PBI_FormatHint = {"isText":true}

			measure 'Unit Cost' =
					
					CALCULATE (
					    IF ( ISINSCOPE ( '42 - Product'[Title] ), MAX ( '42 - Product'[Cost Price] ) ),
					    REMOVEFILTERS ( '42 - Product'[Model Year] )
					)
				formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
				displayFolder: 52 - Order Planner
				lineageTag: 55f87888-57de-493a-b2c3-0b6d5251c978

			measure 'Unit Margin %' =
					
					IF (
					    ISINSCOPE ( '42 - Product'[Title] ),
					    VAR VatRate = 0.23
					    VAR Cost =
					        MAX ( '42 - Product'[Cost Price] )
					    VAR SellIncVat =
					        MAX ( '42 - Product'[Selling Price 1] )
					    VAR SellExVat =
					        DIVIDE ( SellIncVat, 1 + VatRate )
					    VAR Margin = SellExVat - Cost
					    RETURN
					        DIVIDE ( Margin, SellExVat )
					)
				formatString: 0%;-0%;0%
				displayFolder: 52 - Order Planner
				lineageTag: 92ba7048-96a9-410d-8772-4baa98bd8226

			measure 'Avg Unit Margin %' =
					
					AVERAGEX ( VALUES ( '42 - Product'[Title] ), [Unit Margin %] )
				formatString: 0%;-0%;0%
				displayFolder: 52 - Order Planner
				lineageTag: b427915f-95b8-4b1b-be24-567a556211ed

			measure 'Unit Margin % (Weighted)' =
					
					VAR VatRate = 0.23
					RETURN
					    DIVIDE (
					        SUMX (
					            VALUES ( '42 - Product'[Product Key] ),
					            DIVIDE ( MAX ( '42 - Product'[Selling Price 1] ), 1 + VatRate )
					                - MAX ( '42 - Product'[Cost Price] )
					        ),
					        SUMX (
					            VALUES ( '42 - Product'[Product Key] ),
					            DIVIDE ( MAX ( '42 - Product'[Selling Price 1] ), 1 + VatRate )
					        )
					    )
				formatString: 0%;-0%;0%
				displayFolder: 52 - Order Planner
				lineageTag: 1f620770-eaac-4edc-9f14-b015ea7a2629

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Unit Price' =
					
					IF (
					    ISINSCOPE ( '42 - Product'[Title] ),
					    MAX ( '42 - Product'[Selling Price 1] )
					)
				formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
				displayFolder: 52 - Order Planner
				lineageTag: 56952580-e7ad-4849-aa7c-c1e5ba0eeb44

			measure 'Forecasted Requirement (Of Group)' =
					
					VAR result = [Net Units Sold (Last Sep–Feb Period) (Group)] /*-  [Winter Stock Estimate (Of Group)]*/
					RETURN
					    IF ( NOT ISINSCOPE ( '42 - Product'[Title] ), MAX ( 0, result ) )
				formatString: #,0
				displayFolder: 52 - Order Planner
				lineageTag: f7b657c4-9cc9-45d1-b7ef-87057b6e002b

			measure 'Weighted Requirement' =
					
					VAR Factor =
					    COALESCE ( SELECTEDVALUE ( '64 - Order Factor'[Value %] ), 1 )
					VAR Result =
					    ROUND (
					        ( [Net Units Sold (Last Sep–Feb Period) (Group)] * Factor ) /* - [Winter Stock Estimate (Of Group)]*/
					        ,
					        0
					    )
					RETURN
					    IF ( NOT ISINSCOPE ( '42 - Product'[Title] ), MAX ( 0, Result ) )
				formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
				displayFolder: 52 - Order Planner
				lineageTag: 53e19752-dd37-4116-b748-9432986d5207

			measure SKU =
					
					IF ( ISINSCOPE ( '42 - Product'[Title] ), MAX ( '42 - Product'[Stock Code] ) )
				formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
				displayFolder: 52 - Order Planner\Derived
				lineageTag: 7667f533-eb56-476d-a771-b52db872fdd5

			measure 'Net COGS (Last Sep–Feb Period)' =
					
					VAR AsOfDate =
					    CALCULATE (
					        MAX ( '41 - Document Date'[Date] ),
					        REMOVEFILTERS ( '41 - Document Date' ),
					        '41 - Document Date'[Is Completed Day] = TRUE ()
					    )
					VAR Result =
					    CALCULATE (
					        [Sales Net COGS],
					        DATESINPERIOD ( '41 - Document Date'[Date], AsOfDate, -12, MONTH ),
					        KEEPFILTERS ( '41 - Document Date'[Month Number] IN { 9, 10, 11, 12, 1, 2 } ),
					        -- critical: don't let the matrix "shown titles" restrict COGS
					        REMOVEFILTERS ( '42 - Product'[Title] )
					    )
					RETURN
					    IF (
					        NOT ISINSCOPE ( '42 - Product'[Title] ),
					        MAX ( 0, COALESCE ( Result, 0 ) )
					    )
				formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
				displayFolder: 52 - Order Planner
				lineageTag: ca36f368-463b-4174-af8c-8601bd34c4a2

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Show Title (Sold Sep–Feb OR Selected MY)' =
					
					VAR AsOfDate =
					    CALCULATE (
					        MAX ( '41 - Document Date'[Date] ),
					        REMOVEFILTERS ( '41 - Document Date' ),
					        '41 - Document Date'[Is Completed Day] = TRUE ()
					    ) -- sold in your Sep–Feb window, IGNORE model year
					VAR UnitsSepFeb =
					    CALCULATE (
					        [Sales Net Units Sold],
					        DATESINPERIOD ( '41 - Document Date'[Date], AsOfDate, -12, MONTH ),
					        KEEPFILTERS ( '41 - Document Date'[Month Number] IN { 9, 10, 11, 12, 1, 2 } ),
					        REMOVEFILTERS ( '42 - Product'[Model Year] )
					    ) -- model year chosen in the disconnected slicer
					VAR SelMY =
					    SELECTEDVALUE ( '67 - Model Year Selector'[Model Year] ) -- this title’s model year (if multiple rows per title, MAX is the practical choice)
					VAR ThisMY =
					    CALCULATE ( MAX ( '42 - Product'[Model Year] ) )
					VAR InSelectedMY =
					    NOT ISBLANK ( SelMY ) && ThisMY = SelMY
					RETURN
					    IF ( COALESCE ( UnitsSepFeb, 0 ) > 0 || InSelectedMY, 1, 0 )
				formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
				displayFolder: 52 - Order Planner
				lineageTag: 32c5ea47-4674-4e6c-87a4-6474c875fdaf

				annotation PBI_FormatHint = {"isGeneralNumber":true}

