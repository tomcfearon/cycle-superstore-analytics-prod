				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'Estimated Retail In-Store Gross Profit YTD Change (Formatted)' =
					
					VAR ChangeVal = [Estimated Retail Profit YTD Change]
					VAR PctVal = [Estimated In-Store Retail Gross Profit YTD Change %]
					VAR ChangeSign =
					    IF ( ChangeVal > 0, "+", "" )
					VAR PctText =
					    IF (
					        ISBLANK ( PctVal ),
					        UNICHAR ( 8734 ),
					        -- "∞"
					        IF ( PctVal > 0, "+", "" ) & FORMAT ( PctVal, "0.0%" )
					    )
					RETURN
					    IF (
					        ISBLANK ( ChangeVal ),
					        "No Sales to Date",
					        ChangeSign & FORMAT ( ChangeVal, "€#,##0" ) & " (" & PctText & ")"
					    )
				displayFolder: 51 - Gross Profit Report\7_Formatted
				lineageTag: 15ab5c21-b375-4d0b-8b9c-ec32f643de1c

			measure 'Sales Net Margin %' =
					
					IF (
					    ISBLANK ( [Sales Gross Profit] ) && ISBLANK ( [Sales Net Sales (Ex VAT)] ),
					    BLANK (),
