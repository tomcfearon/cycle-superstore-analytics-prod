			measure '55 - Total Value Invoice Orders' = ```
					
					
					    VAR _invoiceAmt       = [Order Invoices Amount]
					    VAR _creditAmt        = [Order Credits Amount]
					    VAR _serviceCreditAmt = [Service Credit Amount]
					    RETURN
					        _invoiceAmt + _creditAmt + _serviceCreditAmt
					```
				formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
				displayFolder: 55 - Reconciliation Report\6 - Transactions Report
				lineageTag: b301bdc6-d3f5-43c1-966b-cfe5c904ba36

			measure '55 - Total Value Till Transactions' = ```
					
					
					    VAR _invSigned =
					        SUMX(
					            '02 - Till Invoices',
					            IF(
					                '02 - Till Invoices'[Is From Credit Note],
					                -'02 - Till Invoices'[Price],
					                '02 - Till Invoices'[Price]
					            )
					        )
					    VAR _crdSigned =
					        SUMX(
					            '06 - Till Credits',
					            IF(
					                '06 - Till Credits'[Is From Invoice Note],
					                -'06 - Till Credits'[Price],
					                '06 - Till Credits'[Price]
					            )
					        )
					    RETURN
					        _invSigned + _crdSigned
					```
				formatString: "€"#,0.###############;-"€"#,0.###############;"€"#,0.###############
				displayFolder: 55 - Reconciliation Report\6 - Transactions Report
