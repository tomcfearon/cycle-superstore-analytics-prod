			measure '57 - Retail Margin %' = ```
					
					// 1. Grab Base Measures 
					VAR _Cost    = [57 - Selected Cost Price]
					VAR _AvgSale = [57 - Selected Sale Price]
					VAR _Retail  = [57 - Selected Retail Price]
					
					// 2. Price Logic: Fallback to Retail if Average Sale is Blank or Zero
					VAR _ActivePrice = 
					    IF ( 
					        NOT ISBLANK(_AvgSale) && _AvgSale > 0, 
					        _AvgSale, 
					        _Retail 
					    )
					
					// 3. Calculate Net Margin (Removing 23% VAT from the active selling price)
					VAR _NetPrice = DIVIDE(_ActivePrice, 1.23)
					VAR _MarginValue = DIVIDE( _NetPrice - _Cost, _NetPrice )
					
					// 4. Output Logic
					RETURN
					    IF (
					        (ISINSCOPE('42 - Product'[Product Model]) || ISINSCOPE('42 - Product'[Clean Product Name])) && NOT ISBLANK(_ActivePrice),
					        _MarginValue
					    )
					```
				formatString: 0.0%;-0.0%;0.0%
				displayFolder: 57 - Products Report\Workbook
				lineageTag: e1ccfc40-8a82-4f30-83e7-cc2d22daa3c8

