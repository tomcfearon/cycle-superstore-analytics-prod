					    KEEPFILTERS ( '44 - Employee'[Employee Key] <> -1 ),
					    REMOVEFILTERS ( '42 - Product' ),
					    REMOVEFILTERS ( '43 - Customer' ),
					    REMOVEFILTERS ( '45 - Order Channel' )
					)
				formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
