			measure 'Estimated In-Store Retail Gross Profit YTD Change %' =
					
					DIVIDE (
					    [Estimated Retail Profit YTD Change],
					    [Retail Gross Profit YTD LY (Order Date)]
					)
				displayFolder: 51 - Gross Profit Report\3_Retail Sales Order Date
