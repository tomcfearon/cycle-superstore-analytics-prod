				lineageTag: 4c3f87b8-3fdc-4379-9d5b-d3ac7f0c9102

				annotation PBI_FormatHint = {"currencyCulture":"en-IE"}

			measure '57 - Average Trade Profit 12M' =
					
					
					ROUND(
					IF(ISINSCOPE('42 - Product'[Product Model] )|| ISINSCOPE('42 - Product'[Clean Product Name]),
					CALCULATE(
					    [Sales Average Gross Profit R12M],
					    '43 - Customer'[Retail/Trade] = "Trade"
					)
					)
					,0)
				formatString: "€"#,0.###############;-"€"#,0.###############;"€"#,0.###############
				displayFolder: 57 - Products Report\Workbook
				lineageTag: f2d0446d-1ba2-43c5-afa7-a77a44bfeb86

				annotation PBI_FormatHint = {"currencyCulture":"en-IE"}

			measure '57 - Sold Last 12 Months In Stock' = ```
					
					VAR r =
					CALCULATE (
					    [Sales Units Sold R12M],
					    FILTER (
					        VALUES ( '42 - Product'[Stock Code] ), 
					        NOT ISBLANK ( [57 - Stock On Hand (Remove Filter)] )
					    )
					)
					VAR t = 
					IF( ISBLANK(r), 0, r)
					
					RETURN
					IF(ISINSCOPE('42 - Product'[Product Model])|| ISINSCOPE('42 - Product'[Clean Product Name]),
					t)
					```
				formatString: 0
				displayFolder: 57 - Products Report\Workbook
				lineageTag: f1d6f780-0dbf-4838-b926-4d305fe452f3

			measure 'Group Discontinued Status' = ```
					
					// 1. Count how many items in the current filter context are NOT discontinued
					VAR _ActiveCount = 
					    CALCULATE (
					        COUNTROWS ( '42 - Product' ),
					        '42 - Product'[Is Discontinued] = FALSE
					    )
					
					// 2. Check if the current row/group actually has any data at all to avoid showing values on empty rows
					VAR _TotalCount = COUNTROWS ( '42 - Product' )
					
					// 3. Apply the logic
					
					
					RETURN
					IF(ISINSCOPE('42 - Product'[Product Model]) || ISINSCOPE('42 - Product'[Clean Product Name]),
					    IF (
					        ISBLANK ( _TotalCount ),
					        BLANK (), // Hides the result if the category/filter is completely empty
					        IF (
					            _ActiveCount > 0,
					            "Current",
					            "Discontinued"
					        )
					    ))
					```
				displayFolder: 57 - Products Report\Workbook
				lineageTag: aa56bf35-448a-4cb0-8c88-b0f165e7130c

			measure 'Sale Order URLs' = ```
					
					VAR Mode =
					    SELECTEDVALUE ( '62 - Link Mode'[Mode], "Internal" )
					
					-- Define your target types to keep the code clean
					VAR ValidTypes = { "Sales Order" }
					
					-- Safely resolve DocType: Ignores overlapping irrelevant types
					VAR DocType =
					    CALCULATE (
					        SELECTEDVALUE ( '47 - Transaction'[Document Type] ),
					        KEEPFILTERS ( '47 - Transaction'[Document Type] IN ValidTypes )
					    )
					
					-- Safely resolve DocNum: Ignores overlapping irrelevant types
					VAR DocNum =
					    CALCULATE (
					        SELECTEDVALUE ( '47 - Transaction'[Document Number] ),
					        KEEPFILTERS ( '47 - Transaction'[Document Type] IN ValidTypes )
					    )
					
					VAR BaseURL =
					    SWITCH (
					        Mode,
					        "VPN", "http://192.168.195.210/",
					        "Internal", "http://10.1.1.4/",
					        BLANK ()
					    ) 
					
					-- Build the specific link depending on the document type
					RETURN
					    IF (
					        ISBLANK ( BaseURL ),
					        BLANK (),
					        SWITCH (
					            TRUE (),
					            DocType = "Sales Order",
					                BaseURL & "SaleOrders.aspx#ID/" & SUBSTITUTE ( DocNum, "/", "%2F" ),
					            BLANK ()
					        )
					    )
					```
				displayFolder: 20 - Utilities/Hidden\Links
				lineageTag: fa6a4e29-427f-40db-aa0c-3dcb05d21480

