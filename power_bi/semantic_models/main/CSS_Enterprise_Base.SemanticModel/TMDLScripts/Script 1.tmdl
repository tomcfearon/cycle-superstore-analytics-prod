				displayFolder: 02 - Sales\Ratios & Rates
				lineageTag: 733c37cc-2967-4318-846e-2e4f854baf04

			measure 'Sales Discount Rate %' =
					
					DIVIDE ( [Sales Discounts], [Sales Invoice Amount], 0 )
				displayFolder: 02 - Sales\Ratios & Rates
				lineageTag: 09ee88f2-84bf-4307-818e-e881cd322008

			measure 'Sales Invoice Discounts' =
					
					[Order Invoices Discount Amount] + [Till Invoices Discount Amount]
				displayFolder: 02 - Sales\_Totals\‎‎‎‎‎‎‎‏‏‎In‎‎voices
				lineageTag: 5d8239fb-f736-488a-a35b-b12c6a2bbd60

			measure 'Sales Credit Discounts' =
					
					[Order Credits Discount Amount] + [Till Credits Discount Amount]
				displayFolder: 02 - Sales\_Totals\Credits
				lineageTag: 52de720f-b9eb-475a-b25b-934720237047

			measure 'Sales Discounts' =
					
					[Sales Invoice Discounts] - [Sales Credit Discounts]
				displayFolder: 02 - Sales\_Totals\‏‏_Net
				lineageTag: 486ec87b-a973-49f8-a87b-90e1fd8d5e1c

			measure 'Sales Return Rate %' =
					
					DIVIDE ( [Sales Credit Note Count], [Sales Invoice Note Count], 0 )
				displayFolder: 02 - Sales\Ratios & Rates
				lineageTag: df2bfcb1-9cb0-4f40-9e6f-45adccf88736

			measure 'Sales Value YTD' =
					
					CALCULATE (
					    [Sales Value],
					    DATESYTD ( '41 - Document Date'[Date] ),
					    '41 - Document Date'[Is Completed Day] = TRUE
					)
				displayFolder: 02 - Sales\Time Intelligence
				lineageTag: ccc8a651-ba83-4000-885e-d32749bb180c

			measure 'Sales Value MTD' =
					
					CALCULATE (
					    [Sales Value],
					    DATESMTD ( '41 - Document Date'[Date] ),
					    '41 - Document Date'[Is Completed Day] = TRUE
					)
				displayFolder: 02 - Sales\Time Intelligence
				lineageTag: 1a0f73b4-706c-4cb2-a251-b8c2c8f9a018

			measure 'Sales Value LY' =
					
					CALCULATE (
					    [Sales Value],
					    SAMEPERIODLASTYEAR ( '41 - Document Date'[Date] ),
					    '41 - Document Date'[Is Completed Day] = TRUE
					)
				displayFolder: 02 - Sales\Time Intelligence
				lineageTag: 837f646a-9a4c-454f-a359-75abbd414b90

			measure 'Sales Gross Profit LY' =
					
					CALCULATE (
					    [Sales Gross Profit],
					    SAMEPERIODLASTYEAR ( '41 - Document Date'[Date] ),
					    '41 - Document Date'[Is Completed Day] = TRUE
					)
				displayFolder: 02 - Sales\Time Intelligence
				lineageTag: 32bdcf9b-ae69-49cf-a990-b1568a424631

			measure 'Sales Gross Profit MTD ' =
					
					CALCULATE (
					    [Sales Gross Profit],
					    DATESMTD ( '41 - Document Date'[Date] ),
					    '41 - Document Date'[Is Completed Day] = TRUE
					)
				displayFolder: 02 - Sales\Time Intelligence
				lineageTag: ea87906f-8a61-45c7-8f8c-f7967e21ab87

			measure 'Sales Gross Profit YTD' =
					
					CALCULATE (
					    [Sales Gross Profit],
					    DATESYTD ( '41 - Document Date'[Date] ),
					    '41 - Document Date'[Is Completed Day] = TRUE
					)
				displayFolder: 02 - Sales\Time Intelligence
