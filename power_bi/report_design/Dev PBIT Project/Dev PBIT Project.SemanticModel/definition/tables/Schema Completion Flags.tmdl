		annotation SummarizationSetBy = Automatic

	partition 'Schema Completion Flags' = calculated
		mode: import
		source =
				
				// 1. Calculate the exact max refresh date for each schema up front
				VAR Max_int       = CALCULATE(MAX('98 - Refreshes'[Last Refresh Date]), '98 - Refreshes'[Layer Name] = "int")
				VAR Max_marts     = CALCULATE(MAX('98 - Refreshes'[Last Refresh Date]), '98 - Refreshes'[Layer Name] = "marts")
				VAR Max_op        = CALCULATE(MAX('98 - Refreshes'[Last Refresh Date]), '98 - Refreshes'[Layer Name] = "op")
				VAR Max_ccdata    = CALCULATE(MAX('98 - Refreshes'[Last Refresh Date]), '98 - Refreshes'[Layer Name] = "raw_ccdata")
				VAR Max_css2      = CALCULATE(MAX('98 - Refreshes'[Last Refresh Date]), '98 - Refreshes'[Layer Name] = "raw_css2")
				VAR Max_google    = CALCULATE(MAX('98 - Refreshes'[Last Refresh Date]), '98 - Refreshes'[Layer Name] = "raw_google")
				VAR Max_inventory = CALCULATE(MAX('98 - Refreshes'[Last Refresh Date]), '98 - Refreshes'[Layer Name] = "raw_inventory")
				
				// 2. Base the table strictly on your unique Dates
				VAR BaseDates = DISTINCT('41 - Date'[Date])
				
				// 3. Add the individual schema flags as columns
				RETURN
				    ADDCOLUMNS(
				        BaseDates,
				        "Is Completed Day - int",           [Date] <= Max_int,
				        "Is Completed Day - marts",         [Date] <= Max_marts,
				        "Is Completed Day - op",            [Date] <= Max_op,
				        "Is Completed Day - raw_ccdata",    [Date] <= Max_ccdata,
				        "Is Completed Day - raw_css2",      [Date] <= Max_css2,
				        "Is Completed Day - raw_google",    [Date] <= Max_google,
				        "Is Completed Day - raw_inventory", [Date] <= Max_inventory
				    )

	annotation PBI_Id = c613e2d3f2a143c88b20d2a1d58a727b

