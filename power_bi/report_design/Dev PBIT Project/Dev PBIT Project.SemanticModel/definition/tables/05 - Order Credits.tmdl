		lineageTag: e03f31cd-6710-43df-990c-27eabb94c50e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Order Credits Amount (Excl. VAT)' =
			
			SUMX ( '05 - Order Credits', [Price] - [VAT Amount] )
		displayFolder: _Direct Measures
		lineageTag: 33246950-fa85-48ad-af57-d2ec6597dd18

	measure 'Order Credits Discount Amount' =
			
			SUMX ( '05 - Order Credits', [Price Before Discount] - [Price] )
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: _Direct Measures
