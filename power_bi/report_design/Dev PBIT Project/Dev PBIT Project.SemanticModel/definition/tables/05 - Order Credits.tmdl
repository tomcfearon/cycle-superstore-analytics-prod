table '05 - Order Credits'
	lineageTag: def8e7bf-435e-4d46-a716-e5660916b541

	measure 'Order Credits Amount' =
			
			SUMX ( '05 - Order Credits', [Price] )
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: _Direct Measures
		lineageTag: 4c845bf6-78b6-4c76-b04d-f46464396897

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Order Credits COGS' =
			
			SUMX ( '05 - Order Credits', [Cost] )
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: _Direct Measures
		lineageTag: 3c750ee2-f2cd-4046-a111-3bab64f52828

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Order Credits Gross Loss' =
			
			SUMX ( '05 - Order Credits', [Price] - [VAT Amount] - [Cost] )
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: _Direct Measures
		lineageTag: 44ce1e93-a049-42f4-be24-05d38caa3f88

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Order Credits Note Count' =
			
			DISTINCTCOUNT ( '05 - Order Credits'[Transaction Key] )
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: _Direct Measures
		lineageTag: 97e37596-a320-4eb6-ae6a-2315aa5c975d

