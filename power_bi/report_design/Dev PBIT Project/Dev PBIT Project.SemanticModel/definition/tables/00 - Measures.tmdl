	/// used bike button logic added
	/// 
	measure 'Sales Gross Profit 1' =
			
			VAR NetRevenueExVat = ( [Order Invoices Amount] - [Order Credits Amount] - [Order Invoices VAT] + [Order Credits VAT] ) + ( [Till Invoices Amount] - [Till Credits Amount] - [Till Invoices VAT] + [Till Credits VAT] )
			RETURN
			    NetRevenueExVat - [Sales Net COGS]
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: __Internal\2 - Standard\Key Measures
		lineageTag: d8f2d19d-a4e8-4788-bc84-d29ad6859a3d

	measure '55 - Stock Value' =
			
			-- Physical bikes: Quantity On Hand T1 already includes ItemType-6 reserved bikes.
			-- Physical sundry: sum T1 + T2 + Cara, exclude Labour Charges.
			VAR _PhysicalStock =
			    SUMX (
			        FILTER ( '42 - Product', '42 - Product'[Subcategory] <> "Labour Charges" ),
			        ( [Quantity On Hand Cara] + [Quantity On Hand T1] + [Quantity On Hand T2] )
			            * IF ( '42 - Product'[Main/Sundry] = "Main", [Cost Price], [Average Cost Price] )
			    ) -- Sundry on open Sales Orders (QtyTaken * AveCostPrice, exclude Labour Charges)
			-- Bikes on SO are already counted in dim_stock quantities (ItemType=6 rows).
			VAR _SundryOpenSalesOrders =
			    CALCULATE (
			        SUMX (
			            FILTER (
			                '08 - Sales Orders',
			                RIGHT ( '08 - Sales Orders'[Product Key], 2 ) = "-0"
			                    && RELATED ( '42 - Product'[Subcategory] ) <> "Labour Charges"
			            ),
			            '08 - Sales Orders'[Quantity Taken]
			                * RELATED ( '42 - Product'[Average Cost Price] )
			        ),
			        REMOVEFILTERS ( '41 - Date' )
			    ) -- Sundry on open Service Jobs (uninvoiced only).
			VAR _SundryOpenServiceJobs =
			    CALCULATE (
			        SUMX (
			            FILTER (
			                '09 - Service Orders',
			                RIGHT ( '09 - Service Orders'[Product Key], 2 ) = "-0"
			                    && RELATED ( '42 - Product'[Subcategory] ) <> "Labour Charges"
			            ),
			            '09 - Service Orders'[Quantity] * RELATED ( '42 - Product'[Average Cost Price] )
			        ),
			        REMOVEFILTERS ( '41 - Date' )
			    )
			RETURN
			    _PhysicalStock + _SundryOpenSalesOrders + _SundryOpenServiceJobs
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: 55 - Reconciliation Report\2 - Sale By Make
		lineageTag: 7a07f491-8a01-4b83-b1c7-73e4a229ed9a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

