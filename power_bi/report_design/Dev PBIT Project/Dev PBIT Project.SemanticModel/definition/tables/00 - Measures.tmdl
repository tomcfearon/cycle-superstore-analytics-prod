	measure 'Correlation Coefficient' =
			
			VAR _Table =
			    -- Summarize the data at the same granularity as your chart (Year Week)
			    SUMMARIZE (
			        '41 - Date',
			        '41 - Date'[Year Week],
			        "MetricX", [Store Visits + 4 Days],
			        "MetricY", [Chosen Metric] -- Replace with your actual measure
			    )
			VAR _AvgX =
			    AVERAGEX ( _Table, [MetricX] )
			VAR _AvgY =
			    AVERAGEX ( _Table, [MetricY] ) -- Calculate the Covariance (the numerator)
			VAR _Covariance =
			    SUMX ( _Table, ( [MetricX] - _AvgX ) * ( [MetricY] - _AvgY ) ) -- Calculate the Standard Deviations (the denominator)
			VAR _StdDevX =
			    SQRT ( SUMX ( _Table, ( [MetricX] - _AvgX ) ^ 2 ) )
			VAR _StdDevY =
			    SQRT ( SUMX ( _Table, ( [MetricY] - _AvgY ) ^ 2 ) )
			VAR _Denominator = _StdDevX * _StdDevY
			RETURN
			    -- Divide Covariance by the Denominator, handling divide-by-zero errors
			    DIVIDE (
			        _Covariance,
			        _Denominator
			    )
		displayFolder: 56 - Marketing Report
		lineageTag: ff5c411f-d95e-4bc9-8d87-66f903149bf5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

