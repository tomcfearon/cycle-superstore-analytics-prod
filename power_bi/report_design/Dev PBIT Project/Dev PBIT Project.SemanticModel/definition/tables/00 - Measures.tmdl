	measure 'Unit Margin % (Weighted)' =
			
			VAR VatRate = 0.23
			RETURN
			    DIVIDE (
			        SUMX (
			            VALUES ( '42 - Product'[Product Key] ),
			            DIVIDE ( MAX ( '42 - Product'[Selling Price 1] ), 1 + VatRate )
			                - MAX ( '42 - Product'[Cost Price] )
			        ),
			        SUMX (
			            VALUES ( '42 - Product'[Product Key] ),
			            DIVIDE ( MAX ( '42 - Product'[Selling Price 1] ), 1 + VatRate )
			        )
			    )
		formatString: 0%;-0%;0%
		displayFolder: 52 - Order Planner
		lineageTag: 1f620770-eaac-4edc-9f14-b015ea7a2629

		annotation PBI_FormatHint = {"isGeneralNumber":true}

