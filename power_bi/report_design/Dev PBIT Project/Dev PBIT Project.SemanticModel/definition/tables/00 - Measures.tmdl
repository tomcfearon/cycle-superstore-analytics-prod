	measure '55 - Non Collections' =
			
			IF (
			    ISINSCOPE ( '44 - Employee'[Employee Name] ),
			    [55 - Order Revenue (Non Collections)],
			    VAR EmployeeKeys =
			        DISTINCT (
			            UNION (
			                SELECTCOLUMNS (
			                    VALUES ( '01 - Order Invoices'[Employee Key] ),
			                    "employee_key", '01 - Order Invoices'[Employee Key]
			                ),
			                SELECTCOLUMNS (
			                    VALUES ( '05 - Order Credits'[Employee Key] ),
			                    "employee_key", '05 - Order Credits'[Employee Key]
			                )
			            )
			        )
			    RETURN
			        SUMX (
			            EmployeeKeys,
			            VAR EmployeeKey = [employee_key]
			            VAR InvoiceAmount =
			                CALCULATE (
			                    [Order Invoices Amount],
			                    KEEPFILTERS ( '01 - Order Invoices'[Collection Employee Key] = -1 ),
			                    KEEPFILTERS ( '01 - Order Invoices'[Employee Key] = EmployeeKey )
			                )
			            VAR CreditAmount =
			                CALCULATE (
			                    [Order Credits Amount],
			                    KEEPFILTERS ( '05 - Order Credits'[Collection Employee Key] = -1 ),
			                    KEEPFILTERS ( '05 - Order Credits'[Employee Key] = EmployeeKey )
			                )
			            RETURN
			                InvoiceAmount - CreditAmount
			        )
			)
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: 55 - Reconciliation Report\1 - Sale by Salesperson
		lineageTag: c5321e69-92e5-44ab-a5d6-34b7af2362bd

