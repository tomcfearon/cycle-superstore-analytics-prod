	measure 'Sales Gross Profit YTD CY' =
			
			VAR UpToCY =
			    CALCULATE (
			        MAX ( '41 - Date'[Date] ),
			        '41 - Date'[Is Completed Week] = TRUE ()
			    )
			VAR StartCY =
			    DATE ( YEAR ( UpToCY ), 1, 1 )
			RETURN
			    CALCULATE (
			        [Sales Gross Profit (Used Bikes Button)],
			        -- base measure, not the YTD wrapper
			        DATESBETWEEN (
			            '41 - Date'[Date],
			            StartCY,
			            UpToCY
			        )
			    )
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
