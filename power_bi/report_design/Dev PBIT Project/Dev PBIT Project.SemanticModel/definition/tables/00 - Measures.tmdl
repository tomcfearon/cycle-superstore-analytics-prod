	measure '55 - Service Invoices COGS' =
			
			SUMX (
			    '03 - Service Invoices',
			    VAR _invoice_cost = [Cost]
			    VAR _stock_key = [Product Key] -- Labour-* and MISC-3 are synthetic/non-stock items; skip stock cost lookup for these
			    VAR _is_synthetic =
			        LEFT ( _stock_key, 6 ) = "Labour" || _stock_key = "MISC-3" -- Fallback: current stock cost price × qty, to match ERP behaviour for zero-cost invoice lines
			    VAR _stock_cost =
			        COALESCE ( RELATED ( '42 - Product'[Cost Price] ), 0 ) * [Quantity]
			    RETURN
			        IF ( _invoice_cost = 0 && NOT _is_synthetic, _stock_cost, _invoice_cost )
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: 55 - Reconciliation Report\3 - Service by Salesperson
		lineageTag: a035fcd4-3d3e-4011-8efe-35b097bdfd9f

	measure '55 - Service Net COS' =
			
