	measure '55 - Service Bonus Calculated' =
			
			SUMX (
			    VALUES ( '44 - Employee'[Employee Name] ),
			    [Service Net Sales] * CALCULATE ( MAX ( '44 - Employee'[Bonus] ) )
			)
