	measure 'Latest Inventory' =
			
			VAR AbsoluteLatestDate =
			    CALCULATE (
			        MAX ( '10 - Inventory'[Query Date] ),
			        REMOVEFILTERS ( '10 - Inventory' )
			    )
			VAR TotalInventory =
			    CALCULATE (
			        SUM ( '10 - Inventory'[Quantity On Hand Cara] )
			            + SUM ( '10 - Inventory'[Quantity On Hand T1] ),
			        '10 - Inventory'[Query Date] = AbsoluteLatestDate
			    )
			RETURN
			    IF ( TotalInventory = 0, BLANK (), TotalInventory )
		formatString: #,0
		displayFolder: __Internal\_Direct Measures
		lineageTag: 04512384-d231-4334-8aaa-5126ce6f19d0

	measure 'Latest Inventory Cara' =
			
			VAR AbsoluteLatestDate =
			    CALCULATE (
