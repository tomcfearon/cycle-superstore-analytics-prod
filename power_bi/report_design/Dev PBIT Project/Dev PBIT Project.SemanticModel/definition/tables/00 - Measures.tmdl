	measure 'Unit Margin %' =
			
			IF (
			    ISINSCOPE ( '42 - Product'[Title] ),
			    VAR VatRate = 0.23
			    VAR Cost =
			        MAX ( '42 - Product'[Cost Price] )
			    VAR SellIncVat =
			        MAX ( '42 - Product'[Selling Price 1] )
			    VAR SellExVat =
			        DIVIDE ( SellIncVat, 1 + VatRate )
			    VAR Margin = SellExVat - Cost
			    RETURN
			        DIVIDE ( Margin, SellExVat )
			)
		formatString: 0%;-0%;0%
		displayFolder: 52 - Order Planner
		lineageTag: 92ba7048-96a9-410d-8772-4baa98bd8226

	measure 'Avg Unit Margin %' =
			
			AVERAGEX ( VALUES ( '42 - Product'[Title] ), [Unit Margin %] )
