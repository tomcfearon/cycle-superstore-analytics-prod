	measure 'Product Status' =
			
			IF (
			    ISINSCOPE ( '42 - Product'[Title] ),
			    VAR IsNew =
			        COALESCE ( SELECTEDVALUE ( '42 - Product'[Is New] ), FALSE () )
			    VAR SelMY =
			        SELECTEDVALUE ( '67 - Model Year Selector'[Model Year] )
			    VAR ThisMY =
			        CALCULATE ( MAX ( '42 - Product'[Model Year] ) )
			    RETURN
			        SWITCH (
			            TRUE (),
			            IsNew, "New Product",
			            NOT ISBLANK ( SelMY ) && NOT ISBLANK ( ThisMY ) && ThisMY <> SelMY, "Discontinued",
			            "Current Product"
			        )
