	measure '55 - Bonus Text' =
			
			IF (
			    ISINSCOPE ( '44 - Employee'[Employee Key] ),
			    VAR BonusVal =
			        MAX ( '44 - Employee'[Bonus] ) -- Define the formatting logic once to keep it clean
			    VAR FormatBonus =
			        IF ( BonusVal * 100 = INT ( BonusVal * 100 ), "0%", "0.#%" )
			    RETURN
			        IF ( BonusVal = 0, BLANK (), FORMAT ( BonusVal, FormatBonus ) ),
			    BLANK ()
			)
		displayFolder: 55 - Reconciliation Report\3 - Service by Salesperson
		lineageTag: 0f469b88-51fb-4626-89da-f19cb996f0f8

	measure 'Sales Value Sundry' =
			
			[Till Invoices Amount] - [Till Credits Amount]
		formatString: "€"#,0.###############;-"€"#,0.###############;"€"#,0.###############
		displayFolder: 02 - Sales\_Totals\‏‏_Net
		lineageTag: f5c217cb-114f-48cc-96bb-3ce554164c3f

		annotation PBI_FormatHint = {"currencyCulture":"en-IE"}

	measure '55 - Margin % ' =
			
			VAR _OrderNetExVAT =
			    CALCULATE (
			        [Order Invoices Amount (Excl. VAT)],
			        '01 - Order Invoices'[Is Credited] = FALSE,
			        '01 - Order Invoices'[Price] <> 0
			    )
			VAR _TillNetExVAT = [Till Invoices Amount (Excl. VAT)]
			VAR _GrossSaleExVAT = _OrderNetExVAT + _TillNetExVAT
			RETURN
			    DIVIDE ( [Sales Gross Profit], _GrossSaleExVAT )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 55 - Reconciliation Report\2 - Sale By Make
		lineageTag: cbb2db84-74c1-4a9a-9adc-a5d1971ba529

	measure '55 - Total Sale Value' =
			
			VAR _OrderSaleERP =
			    CALCULATE (
			        [Order Invoices Amount],
			        '01 - Order Invoices'[Is Credited] = FALSE
			    )
			VAR _TillSaleERP = [Till Invoices Amount]
			RETURN
			    _OrderSaleERP + _TillSaleERP
		formatString: "€"#,0;-"€"#,0;"€"#,0
		displayFolder: 55 - Reconciliation Report\2 - Sale By Make
		lineageTag: 0b1de72a-70e4-4eee-81f7-cf7fe908d44b

		annotation PBI_FormatHint = {"currencyCulture":"en-IE"}

	measure '55 - P2' =
			
			VAR _total = [55 - Sales Gross Profit]
			RETURN
			    IF ( NOT ISBLANK ( _total ) && _total <> 0, 1, 0 )
		formatString: 0
		displayFolder: 55 - Reconciliation Report\0 - Visual Filters
		lineageTag: 507142d8-8b0b-4636-b8b3-eb7398750906

	measure '55 - Main Stock Value' =
			
			VAR _MainPhysical =
			    SUMX (
			        FILTER (
			            '42 - Product',
			            '42 - Product'[Main/Sundry] = "Main"
			                && '42 - Product'[Subcategory] <> "Labour Charges"
			        ),
			        ( [Quantity On Hand Cara] + [Quantity On Hand T1] + [Quantity On Hand T2] ) * [Cost Price]
			    )
			RETURN
			    _MainPhysical
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: 55 - Reconciliation Report\2 - Sale By Make
		lineageTag: 7e3f1d10-239f-479c-b2aa-efcb15b207fb

	measure '55 - Turn Sale Netto/Stock Value' =
			
			VAR _OrderSaleExVAT =
			    CALCULATE (
			        [Order Invoices Amount (Excl. VAT)],
			        '01 - Order Invoices'[Is Credited] = FALSE
			    )
			VAR _TillSaleExVAT = [Till Invoices Amount (Excl. VAT)]
			VAR _SaleNetto = _OrderSaleExVAT + _TillSaleExVAT
			RETURN
			    DIVIDE ( _SaleNetto, [55 - Stock Value] )
		formatString: "€"#,0.###############;-"€"#,0.###############;"€"#,0.###############
		displayFolder: 55 - Reconciliation Report\2 - Sale By Make
		lineageTag: 17e019b4-6e35-4491-b51a-caa29fbc7841

		annotation PBI_FormatHint = {"currencyCulture":"en-IE"}

	measure '55 - Sundry Stock Value' =
			
			VAR _SundryPhysical =
			    SUMX (
			        FILTER (
			            '42 - Product',
			            '42 - Product'[Main/Sundry] = "Sundry"
			                && '42 - Product'[Subcategory] <> "Labour Charges"
			        ),
			        ( [Quantity On Hand Cara] + [Quantity On Hand T1] + [Quantity On Hand T2] ) * [Average Cost Price]
			    )
			VAR _OpenSalesOrders =
			    CALCULATE (
			        SUMX (
			            FILTER (
			                '08 - Sales Orders',
			                RIGHT ( '08 - Sales Orders'[Product Key], 2 ) = "-0"
			                    && RELATED ( '42 - Product'[Subcategory] ) <> "Labour Charges"
			            ),
			            '08 - Sales Orders'[Quantity Taken]
			                * RELATED ( '42 - Product'[Average Cost Price] )
			        ),
			        REMOVEFILTERS ( '41 - Date' )
			    )
			VAR _OpenServiceJobs =
			    CALCULATE (
			        SUMX (
			            FILTER (
			                '09 - Service Orders',
			                RIGHT ( '09 - Service Orders'[Product Key], 2 ) = "-0"
			                    && RELATED ( '42 - Product'[Subcategory] ) <> "Labour Charges"
			            ),
			            '09 - Service Orders'[Quantity] * RELATED ( '42 - Product'[Average Cost Price] )
			        ),
			        REMOVEFILTERS ( '41 - Date' )
			    )
			RETURN
			    _SundryPhysical + _OpenSalesOrders + _OpenServiceJobs
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		displayFolder: 55 - Reconciliation Report\2 - Sale By Make
		lineageTag: 1ce16557-e017-4099-80eb-474b06ed9121

