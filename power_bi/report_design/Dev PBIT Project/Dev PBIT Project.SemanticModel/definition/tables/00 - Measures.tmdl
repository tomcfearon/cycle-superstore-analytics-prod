	measure 'Used Bikes Gross Profit' =
			
			( ( [Used Bike Revenue] - [Used Bike COGS] ) / 1.23 ) - ( ( [Used Bike COS] / 1.23 ) / 2 )
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
