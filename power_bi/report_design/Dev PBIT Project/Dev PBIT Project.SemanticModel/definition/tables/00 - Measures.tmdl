	measure 'Child Level List' =
			
			VAR MaxItems = 5
			RETURN
			    SWITCH (
			        TRUE (),
			        -- 1. If at Subcategory level (bottom), show nothing (or you could show related brands)
			        ISINSCOPE ( '42 - Product'[Subcategory] ), BLANK (),
			        -- 2. If at Category level, show top 5 Subcategories
			        ISINSCOPE ( '42 - Product'[Category] ),
			            VAR SubCatCount =
			                DISTINCTCOUNT ( '42 - Product'[Subcategory] )
			            VAR TopSubCats =
			                CONCATENATEX (
			                    TOPN ( MaxItems, VALUES ( '42 - Product'[Subcategory] ) ),
			                    '42 - Product'[Subcategory],
			                    ", "
			                )
			            RETURN
			                IF ( SubCatCount > MaxItems, TopSubCats & " and more...", TopSubCats ),
			        -- 3. If at Cat Type level, show top 5 Categories
			        ISINSCOPE ( '42 - Product'[Category Type] ),
			            VAR CatCount =
			                DISTINCTCOUNT ( '42 - Product'[Category] )
			            VAR TopCats =
			                CONCATENATEX (
			                    TOPN ( MaxItems, VALUES ( '42 - Product'[Category] ) ),
			                    '42 - Product'[Category],
			                    ", "
			                )
			            RETURN
			                IF ( CatCount > MaxItems, TopCats & " and more...", TopCats ),
			        BLANK ()
			    )
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: 51 - Gross Profit Report\4_Product
		lineageTag: de5498e2-bb01-4715-a7db-ab4ede3dbff7

	measure 'Estimated In-Store Retail Profit YTD Change (Last Week Filtered)' =
			
			VAR LatestWeekFiltered =
			    CALCULATE ( MAX ( '41 - Date'[Week] ), ALLSELECTED ( '41 - Date' ) )
			VAR CurrentWeekInContext =
			    SELECTEDVALUE ( '41 - Date'[Week] )
			RETURN
			    IF (
			        CurrentWeekInContext = LatestWeekFiltered,
			        [Retail In-Store Gross Profit YTD CY (Order Date)] + [Retail In-Store Orders Gross Profit (.80 Weighting)] - [Retail In-Store Gross Profit YTD LY (Order Date)],
			        BLANK ()
			    )
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: 51 - Gross Profit Report\3_Retail Sales Order Date
		lineageTag: 97d8ae5d-41c2-4734-9fcc-8b1fd264434a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '55 - Qty Invoice Orders' =
			
			COALESCE (
			    DISTINCTCOUNT ( '01 - Order Invoices'[Transaction Key] )
			        + DISTINCTCOUNT ( '05 - Order Credits'[Transaction Key] )
			        + DISTINCTCOUNT ( '07 - Service Credits'[Transaction Key] ),
			    --erp has a bug showing servcredits,
			    0
			)
		formatString: #,0
		displayFolder: 55 - Reconciliation Report\6 - Transactions Report
		lineageTag: 690457a6-705f-4cc4-bfc7-99d1c2cf0b02

	/// ERP counts one row per SundryHeader document.
	/// A partially-credited doc appears in BOTH Till Invoices and Till Credits.
	/// UNION de-duplicates so each document is counted once.
	measure '55 - Qty Till Transactions' =
			
			COALESCE (
			    COUNTROWS (
			        DISTINCT (
			            UNION (
			                VALUES ( '02 - Till Invoices'[Transaction Key] ),
			                VALUES ( '06 - Till Credits'[Transaction Key] )
			            )
			        )
			    ),
			    0
			)
		formatString: #,0
		displayFolder: 55 - Reconciliation Report\6 - Transactions Report
		lineageTag: 9c1b81cb-cd36-493e-afd2-be8dd3f747ce

	/// ERP counts ALL Repairs rows by FaultDate.
	/// Service Invoices = invoiced repairs (switch to Order Date = FaultDate).
	/// Service Orders = uninvoiced repairs (Order Date = FaultDate is active).
	/// Service Credits are InvoiceHeader records — already counted in Qty Invoice.
	measure '55 - Qty Service Orders' =
			
			COALESCE (
			    CALCULATE (
			        DISTINCTCOUNT ( '03 - Service Invoices'[Order Number] ),
			        USERELATIONSHIP ( '03 - Service Invoices'[Order Date], '41 - Date'[Date] )
			    )
			        + DISTINCTCOUNT ( '09 - Service Orders'[Transaction Key] ),
			    0
			)
		formatString: 0
		displayFolder: 55 - Reconciliation Report\6 - Transactions Report
		lineageTag: 6703c52e-875b-412f-98ef-89819ed9f335

	measure 'CCData Last Refresh UTC' =
			
			CALCULATE (
			    MAX ( '98 - Refreshes'[Last Refresh UTC] ),
			    REMOVEFILTERS ( '41 - Date' ),
			    '98 - Refreshes'[Layer Name] = "raw_ccdata"
			)
		formatString: General Date
		displayFolder: 20 - Utilities/Hidden\Refreshes
		lineageTag: 221d5981-4fa8-4c20-aa0d-d1436a11a8e6

	measure 'Inventory Last Refresh UTC' =
			
			CALCULATE (
			    MAX ( '98 - Refreshes'[Last Refresh UTC] ),
