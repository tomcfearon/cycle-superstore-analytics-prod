	measure '55 - Order Revenue (Non Collections)' =
			
			VAR OrderInvoicesNoCollection =
			    CALCULATE (
			        [Order Invoices Amount],
			        KEEPFILTERS ( '01 - Order Invoices'[Collection Employee Key] = -1 )
			    )
			VAR OrderCreditsNoCollection =
			    CALCULATE (
			        [Order Credits Amount],
			        KEEPFILTERS ( '05 - Order Credits'[Collection Employee Key] = -1 )
			    )
			RETURN
			    OrderInvoicesNoCollection - OrderCreditsNoCollection
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
