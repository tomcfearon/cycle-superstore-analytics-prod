	measure '55 - Order Revenue' =
			
			VAR CollectionInvoicesMade =
			    CALCULATE (
			        [Order Invoices Amount],
			        USERELATIONSHIP ( '01 - Order Invoices'[Collection Employee Key], '44 - Employee'[Employee Key] ),
			        KEEPFILTERS ( '01 - Order Invoices'[Collection Employee Key] <> -1 )
			    )
			VAR CollectionCreditsMade =
			    CALCULATE (
			        [Order Credits Amount],
			        USERELATIONSHIP ( '05 - Order Credits'[Collection Employee Key], '44 - Employee'[Employee Key] ),
			        KEEPFILTERS ( '05 - Order Credits'[Collection Employee Key] <> -1 )
			    )
			RETURN
			    CollectionInvoicesMade - CollectionCreditsMade
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: 55 - Reconciliation Report\1 - Sale by Salesperson
		lineageTag: 89397bfa-00ad-42a1-9c00-bd6a2bb10318

	measure 'Orders Net Sales' =
			
			[Order Invoices Amount] - [Order Credits Amount]
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: __Internal\2 - Standard\Net
		lineageTag: 612d7bfe-4fed-420b-a99d-1da342637983

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '55 - Bonus Calculated' =
			
			SUMX (
			    VALUES ( '44 - Employee'[Employee Key] ),
			    VAR BonusRate =
			        CALCULATE ( SELECTEDVALUE ( '44 - Employee'[Bonus], 0 ) )
			    VAR CollectionRate =
			        CALCULATE ( SELECTEDVALUE ( '44 - Employee'[Bonus From Collections], 0 ) )
			    VAR TotalSalesBase =
			        [Sales Net Sales] + COALESCE ( [55 - Used Bikes Revenue], 0 )
			    VAR BaseCommission = TotalSalesBase * BonusRate
			    VAR CollectorDeductionInvoices =
			        CALCULATE (
			            SUMX (
			                FILTER (
			                    '01 - Order Invoices',
			                    '01 - Order Invoices'[Collection Employee Key] <> -1
			                ),
			                VAR CollectorKey = '01 - Order Invoices'[Collection Employee Key]
			                VAR CollectorRateForLine =
			                    LOOKUPVALUE (
			                        '44 - Employee'[Bonus From Collections],
			                        '44 - Employee'[Employee Key], CollectorKey,
			                        0
			                    )
			                RETURN
			                    '01 - Order Invoices'[Price] * CollectorRateForLine
			            )
			        )
			    VAR CollectorDeductionCredits =
			        CALCULATE (
			            SUMX (
			                FILTER (
			                    '05 - Order Credits',
			                    '05 - Order Credits'[Collection Employee Key] <> -1
			                ),
			                VAR CollectorKey = '05 - Order Credits'[Collection Employee Key]
			                VAR CollectorRateForLine =
			                    LOOKUPVALUE (
			                        '44 - Employee'[Bonus From Collections],
			                        '44 - Employee'[Employee Key], CollectorKey,
			                        0
			                    )
			                RETURN
			                    '05 - Order Credits'[Price] * CollectorRateForLine
			            )
			        )
			    VAR CollectionsMadeBonus = [55 - Order Revenue] * CollectionRate
			    RETURN
			        BaseCommission - CollectorDeductionInvoices + CollectorDeductionCredits + CollectionsMadeBonus
			)
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: 55 - Reconciliation Report\1 - Sale by Salesperson
		lineageTag: b50e4bec-9758-4804-93cd-6a2b5938c7f1

	measure '55 - P1' =
			
			VAR SalesActivity =
			    [Sales Net Sales] + COALESCE ( [55 - Used Bikes Revenue], 0 )
			        + COALESCE ( [55 - Order Revenue], 0 )
			        + COALESCE ( [55 - Order Revenue (Collections)], 0 )
			        + COALESCE ( [55 - Order Revenue (Non Collections)], 0 )
			        + COALESCE ( [Sales Gross Profit], 0 )
			RETURN
			    IF ( SalesActivity <> 0, 1, 0 )
		formatString: #,0
		displayFolder: 55 - Reconciliation Report\0 - Visual Filters
		lineageTag: a5fc7d59-15ab-45c4-8101-5cf224d45b3e

