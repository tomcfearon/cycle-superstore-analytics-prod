	measure 'Net Units Sold (Last Sep–Feb Period) (title level)' =
			
			VAR AsOfDate =
			    CALCULATE (
			        MAX ( '41 - Date'[Date] ),
			        REMOVEFILTERS ( '41 - Date' ),
			        '41 - Date'[Is Completed Day] = TRUE ()
			    )
			VAR Result =
			    CALCULATE (
			        [Sales Net Units Sold],
			        DATESINPERIOD ( '41 - Date'[Date], AsOfDate, -12, MONTH ),
			        KEEPFILTERS ( '41 - Date'[Month Number] IN { 9, 10, 11, 12, 1, 2 } )
			    )
			VAR Units0 =
			    MAX ( 0, COALESCE ( Result, 0 ) )
			RETURN
			    IF (
			        ISINSCOPE ( '42 - Product'[Title] ),
			        IF ( [Product Status] = "New Product", BLANK (), Units0 )
			    )
		formatString: 0
		displayFolder: 52 - Order Planner
		lineageTag: 61efa5c5-5fbc-4d52-a046-5576e4af336d

	measure 'Product Status (Ungated)' =
			
			VAR IsNew =
			    COALESCE ( SELECTEDVALUE ( '42 - Product'[Is New] ), FALSE () )
			VAR SelMY =
			    SELECTEDVALUE ( '67 - Model Year Selector'[Model Year] )
			VAR ThisMY =
			    CALCULATE ( MAX ( '42 - Product'[Model Year] ) )
			VAR IsDiscontinued =
			    NOT ISBLANK ( SelMY ) && NOT ISBLANK ( ThisMY ) && ThisMY <> SelMY
			RETURN
			    SWITCH (
			        TRUE (),
			        IsNew, "New Product",
			        IsDiscontinued, "Discontinued",
			        BLANK ()
			    )
		displayFolder: 52 - Order Planner
		lineageTag: 97af2cfe-27a6-4b8c-95c6-72e6e2919fac

		annotation PBI_FormatHint = {"isText":true}

