	measure 'Weighted Requirement' =
			
			VAR Factor =
			    COALESCE ( SELECTEDVALUE ( '64 - Order Factor'[Value %] ), 1 )
			VAR Result =
			    ROUND (
			        ( [Net Units Sold (Last Sep–Feb Period) (Group)] * Factor ) /* - [Winter Stock Estimate (Of Group)]*/
			        ,
			        0
			    )
			RETURN
			    IF ( NOT ISINSCOPE ( '42 - Product'[Title] ), MAX ( 0, Result ) )
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: 52 - Order Planner
		lineageTag: 53e19752-dd37-4116-b748-9432986d5207

	measure SKU =
			
			IF ( ISINSCOPE ( '42 - Product'[Title] ), MAX ( '42 - Product'[Stock Code] ) )
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: 52 - Order Planner\Derived
		lineageTag: 7667f533-eb56-476d-a771-b52db872fdd5

	measure 'Net COGS (Last Sep–Feb Period)' =
			
			VAR AsOfDate =
			    CALCULATE (
			        MAX ( '41 - Date'[Date] ),
			        REMOVEFILTERS ( '41 - Date' ),
			        '41 - Date'[Is Completed Day] = TRUE ()
			    )
			VAR Result =
			    CALCULATE (
			        [Sales Net COGS],
			        DATESINPERIOD ( '41 - Date'[Date], AsOfDate, -12, MONTH ),
			        KEEPFILTERS ( '41 - Date'[Month Number] IN { 9, 10, 11, 12, 1, 2 } ),
			        -- critical: don't let the matrix "shown titles" restrict COGS
			        REMOVEFILTERS ( '42 - Product'[Title] )
			    )
			RETURN
			    IF (
			        NOT ISINSCOPE ( '42 - Product'[Title] ),
			        MAX ( 0, COALESCE ( Result, 0 ) )
			    )
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: 52 - Order Planner
		lineageTag: ca36f368-463b-4174-af8c-8601bd34c4a2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Show Title (Sold Sep–Feb OR Selected MY)' =
			
			VAR AsOfDate =
			    CALCULATE (
			        MAX ( '41 - Date'[Date] ),
			        REMOVEFILTERS ( '41 - Date' ),
			        '41 - Date'[Is Completed Day] = TRUE ()
			    ) -- sold in your Sep–Feb window, IGNORE model year
			VAR UnitsSepFeb =
			    CALCULATE (
			        [Sales Net Units Sold],
			        DATESINPERIOD ( '41 - Date'[Date], AsOfDate, -12, MONTH ),
			        KEEPFILTERS ( '41 - Date'[Month Number] IN { 9, 10, 11, 12, 1, 2 } ),
			        REMOVEFILTERS ( '42 - Product'[Model Year] )
			    ) -- model year chosen in the disconnected slicer
			VAR SelMY =
			    SELECTEDVALUE ( '67 - Model Year Selector'[Model Year] ) -- this title’s model year (if multiple rows per title, MAX is the practical choice)
			VAR ThisMY =
			    CALCULATE ( MAX ( '42 - Product'[Model Year] ) )
			VAR InSelectedMY =
			    NOT ISBLANK ( SelMY ) && ThisMY = SelMY
			RETURN
			    IF ( COALESCE ( UnitsSepFeb, 0 ) > 0 || InSelectedMY, 1, 0 )
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: 52 - Order Planner
		lineageTag: 32c5ea47-4674-4e6c-87a4-6474c875fdaf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Dbg Sel MY' =
			
			SELECTEDVALUE ( '42 - Product'[Model Year] )
		displayFolder: 52 - Order Planner
		lineageTag: 544747e8-8b0b-4e59-b74e-7e9f6056559d

