	measure '55 - Total Value Service Orders' =
			
			VAR _invoiced =
			    CALCULATE (
			        [Service Invoice Amount],
			        USERELATIONSHIP ( '03 - Service Invoices'[Order Date], '41 - Date'[Date] )
			    )
			VAR _orders =
			    SUM ( '09 - Service Orders'[Price] )
			RETURN
			    COALESCE ( _invoiced, 0 ) + COALESCE ( _orders, 0 )
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
