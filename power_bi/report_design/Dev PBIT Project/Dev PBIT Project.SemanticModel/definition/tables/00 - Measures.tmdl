			    SELECTEDVALUE ( '62 - Link Mode'[Mode], "Internal" ) -- Use Transaction dim for all doc types; Purchase Orders remain separate
			VAR RawInv =
			    COALESCE (
			        SELECTEDVALUE ( '47 - Transaction'[Document Number] ),
			        SELECTEDVALUE ( '12 - Purchase Orders'[Order Number] )
			    )
			RETURN
			    IF ( NOT ISBLANK ( RawInv ), IF ( Mode = "VPN", "VPN Link", "Link" ), BLANK () )
