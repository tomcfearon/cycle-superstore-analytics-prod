	measure 'Service Net Margin %' =
			
			IF (
			    ISBLANK ( [Service Gross Profit 1] ) && ISBLANK ( [Service Net Sales (Ex VAT)] ),
			    BLANK (),
			    COALESCE (
			        DIVIDE ( [Service Gross Profit 1], [Service Net Sales (Ex VAT)] ),
			        0
			    )
