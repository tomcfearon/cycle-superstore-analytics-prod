	measure 'Show Value For Dates' =
			
			VAR LastDateWithData =
			    CALCULATE ( MAX ( '01 - Order Invoices'[Order Date] ), REMOVEFILTERS () )
			VAR FirstDateVisible =
			    MIN ( '41 - Date'[Date] )
			VAR Result = FirstDateVisible <= LastDateWithData
			RETURN
			    Result
		formatString: """TRUE"";""TRUE"";""FALSE"""
		displayFolder: __Internal
		lineageTag: 617e3f66-cad7-4e79-9be4-2fd04d5878a8

