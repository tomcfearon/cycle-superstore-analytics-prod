	measure 'Used Bikes Gross Sales' =
			
			IF (
			    CALCULATE (
			        SUMX ( '04 - Used Bikes', [Sold Price] ),
			        '04 - Used Bikes'[Used Bike Status] IN { "Sold" /*", "Scrap"*/
			            }
			    ) = 0,
			    BLANK ()
			)
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: __Internal\3 - Used Bikes Memo
		lineageTag: cacc29fb-02f8-417c-bee0-c92323acf72a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Used Bikes Total Cost' =
			
