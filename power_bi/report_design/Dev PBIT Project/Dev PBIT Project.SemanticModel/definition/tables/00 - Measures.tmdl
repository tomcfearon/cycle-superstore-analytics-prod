	measure 'Gross Profit Percentage (Category Levels)' =
			
			VAR Numerator = [Sales Gross Profit]
			VAR Denominator =
			    SWITCH (
			        TRUE (),
			        -- If we're at Title level, parent is Product Group Title
			        ISINSCOPE ( '42 - Product'[Title] ), CALCULATE ( [Sales Gross Profit], REMOVEFILTERS ( '42 - Product'[Title] ) ),
			        -- If we're at Product Group Title, parent is Subcategory
			        ISINSCOPE ( '42 - Product'[Product Group Title] ),
			            CALCULATE (
			                [Sales Gross Profit],
			                REMOVEFILTERS ( '42 - Product'[Product Group Title] )
			            ),
			        -- If we're at Subcategory, parent is Category
			        ISINSCOPE ( '42 - Product'[Subcategory] ),
			            CALCULATE (
			                [Sales Gross Profit],
			                REMOVEFILTERS ( '42 - Product'[Subcategory] )
			            ),
			        -- If we're at Category, parent is the total within selection
			        ISINSCOPE ( '42 - Product'[Category] ), CALCULATE ( [Sales Gross Profit], ALLSELECTED ( '42 - Product' ) ),
			        -- Fallback
			        CALCULATE ( [Sales Gross Profit], ALLSELECTED ( '42 - Product' ) )
			    )
			RETURN
			    DIVIDE ( Numerator, Denominator )
		formatString: 0%;-0%;0%
		displayFolder: 51 - Gross Profit Report\4_Product
		lineageTag: 62076cdd-b209-4a25-a90d-0f0852561edd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Retail Gross Profit YTD Change (Formatted)' =
			
			VAR ChangeVal = [Retail Gross Profit YTD Change]
			VAR PctVal = [Retail Gross Profit YTD Change %]
			VAR ChangeSign =
			    IF ( ChangeVal > 0, "+", "" )
			VAR PctText =
			    IF (
			        ISBLANK ( PctVal ),
			        UNICHAR ( 8734 ),
			        -- "∞"
			        IF ( PctVal > 0, "+", "" ) & FORMAT ( PctVal, "0.0%" )
			    )
			RETURN
			    IF (
			        ISBLANK ( ChangeVal ),
			        "No Sales to Date",
			        ChangeSign & FORMAT ( ChangeVal, "€#,##0" ) & " (" & PctText & ")"
			    )
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: 51 - Gross Profit Report\7_Formatted
		lineageTag: 80dd794d-1507-4f48-b9d2-184431464001

