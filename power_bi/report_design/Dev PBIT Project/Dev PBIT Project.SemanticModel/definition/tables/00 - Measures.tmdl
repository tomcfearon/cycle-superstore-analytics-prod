	measure '55 - Order Revenue (Collections)' =
			
			VAR OrderInvoicesWithCollection =
			    CALCULATE (
			        [Order Invoices Amount],
			        KEEPFILTERS ( '01 - Order Invoices'[Collection Employee Key] <> -1 )
			    )
			VAR OrderCreditsWithCollection =
			    CALCULATE (
			        [Order Credits Amount],
			        KEEPFILTERS ( '05 - Order Credits'[Collection Employee Key] <> -1 )
			    )
			RETURN
			    OrderInvoicesWithCollection - OrderCreditsWithCollection
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
