	measure 'Cara Inventory Daily AVG' =
			
			AVERAGEX ( VALUES ( '10 - Inventory'[Query Date] ), [Latest Inventory] )
		formatString: #,0
		displayFolder: __Internal\__Internal\Time Intelligence
		lineageTag: c7a5f9e9-333a-4115-ae97-a6ff3fe05822

	measure 'Current Year Week' =
			
			VAR d =
			    TODAY ()
			RETURN
			    IF (
			        ISBLANK ( d ),
			        BLANK (),
			        FORMAT ( d, "dddd" ) & ", Week " & FORMAT ( WEEKNUM ( d, 2 ), "00" ) -- non-ISO: week starts Monday, week 1 starts Jan 1
			        & " ("
			            & FORMAT ( YEAR ( d ), "0000" ) & ")"
			    )
		displayFolder: 20 - Utilities/Hidden\Display Text
		lineageTag: 279ce6e9-a5d4-4cfa-9f2f-0b87003c1dab

		annotation PBI_FormatHint = {"isText":true}

	measure 'Transaction URL' =
			
			VAR Mode =
			    SELECTEDVALUE ( '62 - Link Mode'[Mode], "Internal" ) -- Resolve document identity from the Transaction dimension
			VAR DocType =
			    SELECTEDVALUE ( '47 - Transaction'[Document Type] )
			VAR DocNum =
			    SELECTEDVALUE ( '47 - Transaction'[Document Number] )
			VAR PurchOrd =
			    SELECTEDVALUE ( '12 - Purchase Orders'[Order Number] ) -- 1. Determine the Base IP/URL based on the selected mode
			VAR BaseURL =
			    SWITCH (
			        Mode,
			        "VPN", "http://192.168.195.210/",
			        "Internal", "http://10.1.1.4/",
			        BLANK ()
			    ) -- 2. Build the specific link depending on document type
			RETURN
			    IF (
			        ISBLANK ( BaseURL ),
			        BLANK (),
			        SWITCH (
			            TRUE (),
			            -- Order Invoices
			            DocType = "Order Invoice",
			                BaseURL & "SalesInvoicing.aspx#ID/" & SUBSTITUTE ( DocNum, "/", "%2F" ),
			            -- Till Invoices (Requires the /3 suffix)
			            DocType = "Till Invoice",
			                BaseURL & "POS.aspx#ID/" & SUBSTITUTE ( DocNum, "/", "%2F" ) & "/3",
			            -- Service Invoices
			            DocType = "Service Invoice",
			                BaseURL & "Service.aspx#ID/" & SUBSTITUTE ( DocNum, "/", "%2F" ),
			            -- Order Credits
			            DocType = "Order Credit",
			                BaseURL & "CreditNote.aspx#ID/" & SUBSTITUTE ( DocNum, "/", "%2F" ),
			            -- Till Credits (Requires the /4 suffix)
			            DocType = "Till Credit",
			                BaseURL & "POS.aspx#ID/" & SUBSTITUTE ( DocNum, "/", "%2F" ) & "/4",
			            -- Sales Orders
			            DocType = "Sales Order",
			                BaseURL & "SaleOrders.aspx#ID/" & SUBSTITUTE ( DocNum, "/", "%2F" ),
			            -- Purchase Orders (not in dim_transaction — use direct SELECTEDVALUE)
			            NOT ISBLANK ( PurchOrd ),
			                BaseURL & "PurchaseOrders.aspx#ID/" & SUBSTITUTE ( PurchOrd, "/", "%2F" ),
			            -- Fallback if nothing is in scope
			            BLANK ()
			        )
			    )
		displayFolder: 20 - Utilities/Hidden\Links
		lineageTag: ff3aadc9-cdf8-4907-88a5-b2b1036832d1
		dataCategory: WebUrl

		annotation PBI_FormatHint = {"isText":true}

	measure 'CCData Last Refresh (Text)' =
			
			VAR _LatestRefresh = [CCData Last Refresh UTC]
			RETURN
			    IF (
			        ISBLANK ( _LatestRefresh ),
			        "No Data",
			        "Last Refreshed: " & FORMAT ( _LatestRefresh, "dd/mm/yy HH:mm" ) & " UTC"
			    )
		displayFolder: 20 - Utilities/Hidden\Display Text\Refreshes
		lineageTag: 5cbd1132-1663-4ebb-99dd-58a83bb5d8c8

