	measure 'Stock Value' =
			
			VAR LastAvailableDate =
			    LASTDATE ( '41 - Date'[Date] )
			RETURN
			    CALCULATE (
			        SUMX ( '42 - Product', [Total Inventory] * '42 - Product'[Cost Price] ),
			        '10 - Inventory'[Query Date] = LastAvailableDate
			    )
		displayFolder: 05 - Inventory\Valuations
		lineageTag: 3b653a31-ee63-4bb6-ba75-c147fdda54e1

	measure 'Net Margin % (Of Group)' =
			
			VAR AsOfDate =
			    CALCULATE (
			        MAX ( '41 - Date'[Date] ),
			        REMOVEFILTERS ( '41 - Date' ),
			        '41 - Date'[Is Completed Day] = TRUE ()
			    )
			VAR BaseResult =
			    CALCULATE (
			        [Sales Net Margin %],
			        DATESINPERIOD ( '41 - Date'[Date], AsOfDate, -12, MONTH ),
			        KEEPFILTERS ( '41 - Date'[Month Number] IN { 9, 10, 11, 12, 1, 2 } ),
			        REMOVEFILTERS ( '42 - Product'[Title] ) -- key part (prevents Show Title from changing it)
			    )
			RETURN
			    IF ( ISINSCOPE ( '42 - Product'[Title] ), BLANK (), BaseResult )
		formatString: 0%;-0%;0%
		displayFolder: 52 - Order Planner\Base
		lineageTag: 8edfa5c9-5ca9-42a3-82dd-02f711d7c392

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Net Units Sold (Last Sep–Feb Period) (Group)' =
			
			IF (
			    NOT ISINSCOPE ( '42 - Product'[Title] ),
			    SUMX (
			        VALUES ( '42 - Product'[Title] ),
			        [Net Units Sold (Last Sep–Feb Period) (Title)]
			    )
			)
		formatString: 0
		displayFolder: 52 - Order Planner
		lineageTag: 5d412617-8d8c-4adf-89fb-60f60da35fc4

	measure 'Sold Units (Last Sep–Feb, Ignore Title)' =
			
			VAR AsOfDate =
			    CALCULATE (
			        MAX ( '41 - Date'[Date] ),
			        REMOVEFILTERS ( '41 - Date' ),
			        '41 - Date'[Is Completed Day] = TRUE ()
			    )
			VAR Result =
			    IF (
			        NOT ISINSCOPE ( '42 - Product'[Title] ),
			        CALCULATE (
			            [Sales Net Units Sold],
			            DATESINPERIOD ( '41 - Date'[Date], AsOfDate, -12, MONTH ),
			            KEEPFILTERS ( '41 - Date'[Month Number] IN { 9, 10, 11, 12, 1, 2 } ),
			            REMOVEFILTERS ( '42 - Product'[Title] ),
			            REMOVEFILTERS ( '42 - Product'[Model Year] )
			        )
			    )
			RETURN
			    IF ( NOT ISINSCOPE ( '42 - Product'[Title] ), COALESCE ( Result, 0 ), BLANK () )
		formatString: 0
		displayFolder: 52 - Order Planner\Base
		lineageTag: 2dbc5aee-35ed-4cb2-aee3-31bdacd2bef9

	measure Amount =
			
			SUMX (
			    VALUES ( '42 - Product'[Title] ),
			    VAR Qty = [setad ofSuggested Order (Title)]
			    VAR Cost = [Unit Cost]
			    RETURN
			        IF ( NOT ISBLANK ( Qty ) && NOT ISBLANK ( Cost ), Qty * Cost )
			)
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: 52 - Order Planner\Derived
		lineageTag: bf7215cf-7326-4b9d-a6a6-8eb001e6b634

	measure 'setad ofSuggested Order (Title)' =
			
			VAR Factor =
			    COALESCE ( SELECTEDVALUE ( '64 - Order Factor'[Value %] ), 1 )
			VAR ThisStatus = [Product Status (Ungated)]
			RETURN
			    IF (
			        NOT ISINSCOPE ( '42 - Product'[Title] ),
			        BLANK (),
			        IF (
			            ThisStatus = "Discontinued",
			            BLANK (),
			            VAR SoldTitle = [Net Units Sold (Last Sep–Feb Period) (Title)]
			            VAR BaseOrder =
			                ROUND ( SoldTitle * Factor, 0 )
			            VAR TitlesInBucket =
			                CALCULATETABLE (
			                    VALUES ( '42 - Product'[Title] ),
			                    REMOVEFILTERS ( '42 - Product'[Title] )
			                )
			            VAR EligibleTitles =
			                FILTER (
			                    TitlesInBucket,
			                    CALCULATE ( [Product Status (Ungated)] ) <> "Discontinued"
			                )
			            VAR EligibleCount =
			                COUNTROWS ( EligibleTitles )
			            RETURN
			                IF (
			                    EligibleCount = 0,
			                    BLANK (),
			                    VAR SoldDiscontinuedBucket =
			                        SUMX (
			                            FILTER (
			                                TitlesInBucket,
			                                CALCULATE ( [Product Status (Ungated)] ) = "Discontinued"
			                            ),
			                            [Net Units Sold (Last Sep–Feb Period) (Title)]
			                        )
			                    VAR ReplacementDemand =
			                        ROUND ( MAX ( 0, SoldDiscontinuedBucket ) * Factor, 0 )
			                    VAR Cycles =
			                        QUOTIENT ( ReplacementDemand, EligibleCount )
			                    VAR Remainder = ReplacementDemand - ( Cycles * EligibleCount )
			                    VAR RankForRemainder =
			                        RANKX (
			                            EligibleTitles,
			                            VAR CostT =
			                                COALESCE ( [Unit Cost], 999999 )
			                            VAR StatusT =
			                                CALCULATE ( [Product Status (Ungated)] )
			                            VAR SoldT = [Net Units Sold (Last Sep–Feb Period) (Title)]
			                            VAR BaseT =
			                                ROUND ( SoldT * Factor, 0 )
			                            VAR IsNewT =
			                                IF ( StatusT = "New Product", 1, 0 )
			                            VAR NotBoughtT =
			                                IF ( BaseT = 0, 1, 0 )
			                            VAR KeyT =
			                                COALESCE ( CALCULATE ( MIN ( '42 - Product'[Product ID] ) ), 0 ) --instead of index column
			                            RETURN
			                                CostT * 1000000 - IsNewT * 1000 - NotBoughtT + KeyT * 0.000001,
			                            ,
			                            ASC,
			                            DENSE
			                        )
			                    VAR Extra =
			                        IF ( Remainder > 0 && RankForRemainder <= Remainder, 1, 0 )
			                    VAR ReplacementShare = Cycles + Extra
			                    RETURN
			                        MAX ( 0, BaseOrder + ReplacementShare )
			                )
			        )
			    )
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: 52 - Order Planner\Derived
		lineageTag: 9c13aece-3087-4b89-9130-d4557c6b54fd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Net Units Sold (From Equivalent Day LY to Sep 1)' =
			
			VAR AsOfDate =
			    CALCULATE (
			        MAX ( '41 - Date'[Date] ),
			        REMOVEFILTERS ( '41 - Date' ),
			        '41 - Date'[Is Completed Day] = TRUE ()
			    )
			VAR AsOfYear =
			    YEAR ( AsOfDate )
			VAR LY = AsOfYear - 1 -- “Equivalent day of year” (same day-of-year number as AsOfDate, but in last year)
			VAR AsOfDOY =
			    CALCULATE (
			        MAX ( '41 - Date'[Day Of Year Number] ),
			        REMOVEFILTERS ( '41 - Date' ),
			        '41 - Date'[Date] = AsOfDate
			    )
			VAR Sep1_LY =
			    DATE ( LY, 9, 1 )
			RETURN
			    CALCULATE (
			        [Sales Net Units Sold],
			        REMOVEFILTERS ( '42 - Product'[Model Year] ),
			        FILTER (
			            ALL ( '41 - Date' ),
			            '41 - Date'[Year] = LY && '41 - Date'[Day Of Year Number] >= AsOfDOY
			                && '41 - Date'[Date] < Sep1_LY
			        )
			    )
		formatString: 0
		displayFolder: 52 - Order Planner
		lineageTag: b9f58f9a-add0-4cf1-8046-fdc12921d1c0

