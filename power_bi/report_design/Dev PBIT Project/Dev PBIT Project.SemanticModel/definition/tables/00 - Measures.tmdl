	measure 'Days To Completion (Per Invoice)' =
			
			SUMX (
			    VALUES ( '03 - Service Invoices'[Transaction Key] ),
			    VAR OrderDate =
			        CALCULATE ( MIN ( '03 - Service Invoices'[Order Date] ) )
			    VAR CompletionDate =
			        CALCULATE ( MIN ( '03 - Service Invoices'[Completion Date] ) )
			    VAR Days =
			        IF (
			            NOT ISBLANK ( OrderDate ) && NOT ISBLANK ( CompletionDate ),
			            DATEDIFF ( OrderDate, CompletionDate, DAY )
			        )
			    RETURN
			        Days
			)
		formatString: #,0
		displayFolder: 54 - Service Report
		lineageTag: 4c746988-3c1d-406f-9633-a905d2fc950f

	measure 'Selected Engineer' =
			
			CALCULATE (
			    SELECTEDVALUE ( '44 - Employee'[Employee Name] ),
			    USERELATIONSHIP ( '03 - Service Invoices'[Engineer Key], '44 - Employee'[Employee Key] ),
			    CROSSFILTER ( '03 - Service Invoices'[Engineer Key], '44 - Employee'[Employee Key], BOTH )
			)
		displayFolder: 54 - Service Report
