table '44 - Employee'
	lineageTag: a40108fe-7d3c-456b-93b5-7ebd3e2f57cb

	measure '55 - Bonus Text With Collection' =
			
			IF (
			    ISINSCOPE ( '44 - Employee'[Employee Key] ),
			    VAR BonusVal =
			        MAX ( '44 - Employee'[Bonus] )
			    VAR CollectionVal =
			        MAX ( '44 - Employee'[Bonus From Collections] ) -- Define the formatting logic once to keep it clean
			    VAR FormatBonus =
			        IF ( BonusVal * 100 = INT ( BonusVal * 100 ), "0%", "0.#%" )
			    VAR FormatCollection =
			        IF ( CollectionVal * 100 = INT ( CollectionVal * 100 ), "0%", "0.#%" )
			    RETURN
			        IF (
			            BonusVal = 0 && CollectionVal = 0,
			            BLANK (),
			            FORMAT ( BonusVal, FormatBonus ) & " | "
			                & FORMAT ( CollectionVal, FormatCollection )
			        ),
			    BLANK ()
			)
		displayFolder: 55 - Reconciliation Report
		lineageTag: 74f172b0-2c32-4ce4-8998-b6592c7971f7

